// std.sort vs std.algorithm.sort: a plain struct has no built-in `<`, so
// std.algorithm.sort<T> (which only accepts `<`-comparable T) can't sort a
// Vec/slice of them. std.sort.sort<T> takes a caller-supplied
// `fn(T, T) -> bool` comparator instead, so it works for any T, including
// structs — sort a small slice of `Person` by age.
import std.sort;

struct Person {
    age: i64,
}

fn by_age(a: Person, b: Person) -> bool {
    return a.age < b.age;
}

fn main() -> int {
    let people: [Person; 4] = [
        Person { age: 34 },
        Person { age: 8 },
        Person { age: 21 },
        Person { age: 15 },
    ];
    let view: []Person = slice(&people[0], 4);

    sort.sort(view, by_age);
    for index: u64 in 0..4 {
        print(people[index].age);
    }

    let sorted_const: []const Person = slice(&people[0] as *const Person, 4);
    if sort.is_sorted(sorted_const, by_age) { print(1); } else { print(0); }

    return 0;
}
