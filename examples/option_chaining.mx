// Demonstrates std.option's is_some/is_none/unwrap_or against real
// Option-returning functions elsewhere in the stdlib — std.vec.index_of and
// std.strings.parse_i64 — instead of hand-writing a match every time a
// caller just needs a yes/no answer or a default value.
import std.vec;
import std.strings;
import std.option;

fn main() -> int {
    let numbers: Vec<i64> = vec.new<i64>();
    defer vec.destroy(&numbers);
    vec.push(&numbers, 10);
    vec.push(&numbers, 20);
    vec.push(&numbers, 30);

    let found: Option<u64> = vec.index_of(&numbers, 20);
    if option.is_some(found) { print(1); } else { print(0); }
    let missing: Option<u64> = vec.index_of(&numbers, 99);
    if option.is_none(missing) { print(1); } else { print(0); }
    print(option.unwrap_or(vec.index_of(&numbers, 30), 0 as u64) as i64);
    print(option.unwrap_or(vec.index_of(&numbers, 99), 0 as u64) as i64);

    let parsed: Option<i64> = strings.parse_i64(slice("123" as *const u8, 3));
    if option.is_some(parsed) { print(1); } else { print(0); }
    print(option.unwrap_or(parsed, -1));
    let bad: Option<i64> = strings.parse_i64(slice("abc" as *const u8, 3));
    if option.is_none(bad) { print(1); } else { print(0); }
    print(option.unwrap_or(bad, -1));

    return 0;
}
