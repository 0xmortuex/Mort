// The Map a Mort program actually gets from the standard library. std.map scans its keys
// linearly, so this is quadratic in the number of distinct keys and is sized accordingly.
import std.strings;
import std.option;
import std.map;

fn size() -> u64 {
    let text: *u8 = arg_get(1);
    match strings.parse_u64(slice(text as *const u8, len(text))) {
        Option<u64>.Some(value) => { return value; },
        Option<u64>.None => { assert(false); return 0; },
    }
}

fn main() -> int {
    let n: u64 = size();
    let modulus: u64 = 2147483648;
    let space: u64 = n / 2 + 1;
    let table: Map<u64, u64> = map.new<u64, u64>();
    let x: u64 = 42;
    for i: u64 in 0..n {
        x = (x * 1103515245 + 12345) % modulus;
        let key: u64 = x % space;
        match map.get(&table, key) {
            Option<u64>.Some(value) => { map.insert(&table, key, value + 1); },
            Option<u64>.None => { map.insert(&table, key, 1 as u64); },
        }
    }
    let sum: u64 = 0;
    let missing: u64 = 0;
    for key: u64 in 0..n {
        match map.get(&table, key) {
            Option<u64>.Some(value) => { sum = (sum + value * key) % modulus; },
            Option<u64>.None => { missing = missing + 1; },
        }
    }
    print(sum);
    print(missing);
    print(table.length);
    map.destroy(&table);
    return 0;
}
