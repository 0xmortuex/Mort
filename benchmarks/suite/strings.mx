// String workload on std.owned_string and std.strings: build, split, search, change case, hash each byte.
import std.strings;
import std.owned_string;
import std.option;
import std.vec;

fn size() -> u64 {
    let text: *u8 = arg_get(1);
    match strings.parse_u64(slice(text as *const u8, len(text))) {
        Option<u64>.Some(value) => { return value; },
        Option<u64>.None => { assert(false); return 0; },
    }
}

fn main() -> int {
    let n: u64 = size();
    let modulus: u64 = 2147483647;
    let h: u64 = 7;
    let hits: u64 = 0;
    let total: u64 = 0;
    let dash: []const u8 = slice("-" as *const u8, 1);
    let needle: []const u8 = slice("99" as *const u8, 2);
    for i: u64 in 0..n {
        let number: String = strings.from_u64(i);
        let scaled: String = strings.from_u64(i * 7);
        let text: String = owned_string.from("item-" as *u8);
        owned_string.append(&text, owned_string.view(&number));
        owned_string.append(&text, dash);
        owned_string.append(&text, owned_string.view(&scaled));
        let view: []const u8 = owned_string.view(&text);
        let parts: Vec<[]const u8> = strings.split(view, dash);
        if strings.contains(view, needle) {
            hits = hits + 1;
        }
        let upper: String = strings.to_upper(view);
        let upper_view: []const u8 = owned_string.view(&upper);
        total = total + upper_view.len + number.length;
        for index: u64 in 0..upper_view.len {
            h = (h * 31 + upper_view[index] as u64) % modulus;
        }
        vec.destroy(&parts);
        owned_string.destroy(&upper);
        owned_string.destroy(&text);
        owned_string.destroy(&scaled);
        owned_string.destroy(&number);
    }
    print(h);
    print(hits);
    print(total);
    return 0;
}
