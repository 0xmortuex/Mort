// Standalone checker driver: declarations and name resolution for one program.
//
// Usage: check_main MANIFEST OUTPUT
//
// The manifest lists the program's files in the order the Python loader visits
// them, one `FILE <path>` per file, each followed by `ALIAS <name> <mod_name>`
// lines, and starts with `MODE hosted|test|freestanding`. Import resolution
// itself is T8; `selfhost/py_check_dump.py` writes this file from the real loader.
//
// Exit status: 0 checked, 1 a diagnostic on stderr (the tables and events so far
// are written), 2 usage or I/O failure.

import support;
import lexer;
import ast;
import parser;
import typestr;
import checker;

fn cm_read_all(path: *u8) -> Buf {
    let handle = file_open(path, "rb");
    let contents = buf_new(1);
    if handle == (0 as *void) {
        contents.cap = 0;
        return contents;
    }
    let chunk = sup_alloc(65536) as *u8;
    loop {
        let got = file_read(handle, chunk, 65536);
        if got == 0 {
            break;
        }
        for i: u64 in 0..got {
            buf_push(&contents, chunk[i]);
        }
    }
    file_close(handle);
    return contents;
}

// One `FILE` entry of the manifest and its aliases.
struct ManifestFile {
    path: Span,
    alias_names: U64Vec,
    alias_modules: U64Vec,
}

struct Manifest {
    mode: Span,
    files: PtrVec,
}

fn cm_read_manifest(path: *u8, strings: *Interner) -> Manifest {
    let raw = cm_read_all(path);
    if raw.cap == 0 {
        let text = buf_new(256);
        buf_push_z(&text, "check_main: cannot read ");
        buf_push_z(&text, path);
        buf_push(&text, 0);
        eprintln(text.data);
        exit(2);
    }
    let data = buf_span(&raw);
    let result = Manifest { mode: span_z("hosted"), files: ptrvec_new() };
    let start: u64 = 0;
    for i: u64 in 0..data.len {
        if data.data[i] != 10 {
            continue;
        }
        let line = ts_sub(data, start, i);
        start = i + 1;
        if ts_starts_with(line, "MODE ") {
            result.mode = ts_sub(line, 5, line.len);
        } else if ts_starts_with(line, "FILE ") {
            let entry = sup_alloc(sizeof<ManifestFile>()) as *ManifestFile;
            let raw_path = ts_sub(line, 5, line.len);
            let copy = intern(strings, raw_path);
            *entry = ManifestFile {
                path: intern_text(strings, copy),
                alias_names: u64vec_new(),
                alias_modules: u64vec_new(),
            };
            ptrvec_push(&result.files, entry as *void);
        } else if ts_starts_with(line, "ALIAS ") {
            let rest = ts_sub(line, 6, line.len);
            let cut = ts_find(rest, ' ');
            if cut == rest.len || result.files.len == 0 {
                sup_die("check_main: malformed ALIAS line");
            }
            let entry = ptrvec_get(&result.files, result.files.len - 1) as *ManifestFile;
            u64vec_push(&(*entry).alias_names, ts_sub_h(strings, rest, 0, cut));
            u64vec_push(&(*entry).alias_modules, ts_sub_h(strings, rest, cut + 1, rest.len));
        }
    }
    return result;
}

fn cm_tag_all(root: *Node, file: u64) {
    let stack = ptrvec_new();
    ptrvec_push(&stack, root as *void);
    while stack.len > 0 {
        let n = ptrvec_pop(&stack) as *Node;
        (*n).file = file;
        ck_push_children(&stack, n);
    }
}

fn cm_tag_list(list: *PtrVec, file: u64) {
    for i: u64 in 0..(*list).len {
        cm_tag_all(ast_item(list, i), file);
    }
}

fn cm_extend(to: *PtrVec, from: *PtrVec) {
    for i: u64 in 0..(*from).len {
        ptrvec_push(to, ptrvec_get(from, i));
    }
}

fn cm_symbol(strings: *Interner, mod_name: u64, name: u64) -> u64 {
    if mod_name == NO_TEXT {
        return name;
    }
    let b = buf_new(64);
    buf_push_span(&b, intern_text(strings, mod_name));
    buf_push(&b, '.');
    buf_push_span(&b, intern_text(strings, name));
    return intern(strings, buf_span(&b));
}

// Parses one manifest file and merges it into `all`, doing what
// compile_files_to_c and _compile_programs do to each source program.
fn cm_add_file(entry: *ManifestFile, strings: *Interner, all: *Program, first_columns: *Map) {
    let path = (*entry).path;
    let raw = cm_read_all(path.data);
    if raw.cap == 0 {
        let text = buf_new(256);
        buf_push_z(&text, "check_main: cannot read ");
        buf_push_span(&text, path);
        buf_push(&text, 0);
        eprintln(text.data);
        exit(2);
    }
    let source = lx_decode_source(buf_span(&raw));
    if !source.valid {
        diag_fatal(path.data, 0, 0, span_z("source is not valid UTF-8"));
    }
    let lexer = sup_alloc(sizeof<Lexer>()) as *Lexer;
    *lexer = lx_new(source.bytes);
    if !lx_tokenize(lexer) {
        diag_fatal(path.data, (*lexer).err_line, (*lexer).err_col, (*lexer).err_message);
    }
    let program = parse_program(&(*lexer).tokens, strings, path.data);
    let file = intern(strings, path);
    for i: u64 in 0..(*lexer).tokens.len {
        let key = ck_line_key(file, (*lexer).tokens.data[i].line);
        if !map_has(first_columns, key) {
            map_put(first_columns, key, (*lexer).tokens.data[i].col);
        }
    }
    let aliases = sup_alloc(sizeof<Map>()) as *Map;
    *aliases = map_new();
    for i: u64 in 0..(*entry).alias_names.len {
        map_put(aliases, u64vec_get(&(*entry).alias_names, i),
            u64vec_get(&(*entry).alias_modules, i));
    }
    let mod_name = program.module_name;
    for i: u64 in 0..(*program.funcs).len {
        let f = ast_item(program.funcs, i);
        (*f).mod_name = mod_name;
        (*f).symbol = cm_symbol(strings, mod_name, (*f).name);
        (*f).import_aliases = aliases;
    }
    for i: u64 in 0..(*program.externs).len {
        let f = ast_item(program.externs, i);
        (*f).symbol = (*f).name;
    }
    for i: u64 in 0..(*program.tests).len {
        let t = ast_item(program.tests, i);
        (*t).mod_name = mod_name;
        (*t).import_aliases = aliases;
    }
    cm_tag_list(program.funcs, file);
    cm_tag_list(program.structs, file);
    cm_tag_list(program.globals, file);
    cm_tag_list(program.externs, file);
    cm_tag_list(program.enums, file);
    cm_tag_list(program.tests, file);
    cm_tag_list(program.aliases, file);
    cm_extend((*all).funcs, program.funcs);
    cm_extend((*all).structs, program.structs);
    cm_extend((*all).globals, program.globals);
    cm_extend((*all).externs, program.externs);
    cm_extend((*all).enums, program.enums);
    cm_extend((*all).tests, program.tests);
    cm_extend((*all).aliases, program.aliases);
}

fn main() -> int {
    if arg_count() != 3 {
        eprintln("usage: check_main MANIFEST OUTPUT");
        return 2;
    }
    let strings = intern_new();
    let manifest = cm_read_manifest(arg_get(1), &strings);
    let program = program_new();
    let first_columns = map_new();
    for i: u64 in 0..manifest.files.len {
        cm_add_file(ptrvec_get(&manifest.files, i) as *ManifestFile, &strings, &program,
            &first_columns);
    }
    let checker = ck_new(&strings, &program, arg_get(2),
        span_eq_z(manifest.mode, "freestanding"), span_eq_z(manifest.mode, "test"),
        &first_columns);
    ck_run(&checker);
    return 0;
}
