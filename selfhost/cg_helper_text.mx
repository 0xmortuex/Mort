    cg_em(g, "static MORT_NET_INTERNAL int64_t mort_net_udp_send_to(void* raw, uint8_t* host, uint16_t port, const uint8_t* buffer, uint64_t length) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET || host == NULL || buffer == NULL || !mort_net_init()) { return -1; }");
    cg_em(g, "    char service[6];");
    cg_em(g, "    (void)snprintf(service, sizeof(service), \"%u\", (unsigned int)port);");
    cg_em(g, "    struct addrinfo hints = {0};");
    cg_em(g, "    hints.ai_family = AF_UNSPEC;");
    cg_em(g, "    hints.ai_socktype = SOCK_DGRAM;");
    cg_em(g, "    hints.ai_protocol = IPPROTO_UDP;");
    cg_em(g, "    struct addrinfo* addresses = NULL;");
    cg_em(g, "    if (getaddrinfo((const char*)host, service, &hints, &addresses) != 0) { return -1; }");
    cg_em(g, "    int amount = length > 2147483647ULL ? 2147483647 : (int)length;");
    cg_em(g, "    int64_t result = -1;");
    cg_em(g, "    for (struct addrinfo* address = addresses; address != NULL; address = address->ai_next) {");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "        int sent = sendto(socket, (const char*)buffer, amount, 0, address->ai_addr, (int)address->ai_addrlen);");
    cg_em(g, "        if (sent != SOCKET_ERROR) {");
    cg_em(g, "            result = (int64_t)sent;");
    cg_em(g, "            break;");
    cg_em(g, "        }");
    cg_em(g, "#else");
    cg_em(g, "        int flags = 0;");
    cg_em(g, "#ifdef MSG_NOSIGNAL");
    cg_em(g, "        flags = MSG_NOSIGNAL;");
    cg_em(g, "#endif");
    cg_em(g, "        ssize_t sent = sendto(socket, buffer, (size_t)amount, flags, address->ai_addr, address->ai_addrlen);");
    cg_em(g, "        if (sent >= 0) {");
    cg_em(g, "            result = (int64_t)sent;");
    cg_em(g, "            break;");
    cg_em(g, "        }");
    cg_em(g, "#endif");
    cg_em(g, "    }");
    cg_em(g, "    freeaddrinfo(addresses);");
    cg_em(g, "    return result;");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL int64_t mort_net_udp_recv_from(void* raw, uint8_t* buffer, uint64_t length, uint8_t* source_host, uint64_t source_host_capacity, uint16_t* source_port) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET || buffer == NULL || source_host == NULL || source_host_capacity == 0 || source_port == NULL) { return -1; }");
    cg_em(g, "    source_host[0] = 0;");
    cg_em(g, "    *source_port = 0;");
    cg_em(g, "    int amount = length > 2147483647ULL ? 2147483647 : (int)length;");
    cg_em(g, "    struct sockaddr_storage source;");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    int source_length = (int)sizeof(source);");
    cg_em(g, "    int received = recvfrom(socket, (char*)buffer, amount, 0, (struct sockaddr*)&source, &source_length);");
    cg_em(g, "    if (received == SOCKET_ERROR) {");
    cg_em(g, "        if (WSAGetLastError() != WSAEMSGSIZE) { return -1; }");
    cg_em(g, "        received = amount;");
    cg_em(g, "    }");
    cg_em(g, "    DWORD host_capacity = source_host_capacity > 4294967295ULL ? 4294967295UL : (DWORD)source_host_capacity;");
    cg_em(g, "#else");
    cg_em(g, "    socklen_t source_length = (socklen_t)sizeof(source);");
    cg_em(g, "    ssize_t received = recvfrom(socket, buffer, (size_t)amount, 0, (struct sockaddr*)&source, &source_length);");
    cg_em(g, "    if (received < 0) { return -1; }");
    cg_em(g, "    socklen_t host_capacity = source_host_capacity > 2147483647ULL ? (socklen_t)2147483647 : (socklen_t)source_host_capacity;");
    cg_em(g, "#endif");
    cg_em(g, "    if (getnameinfo((struct sockaddr*)&source, source_length, (char*)source_host, host_capacity, NULL, 0, NI_NUMERICHOST) != 0) { return -1; }");
    cg_em(g, "    if (source.ss_family == AF_INET) {");
    cg_em(g, "        *source_port = ntohs(((struct sockaddr_in*)&source)->sin_port);");
    cg_em(g, "    }");
    cg_em(g, "#ifdef AF_INET6");
    cg_em(g, "    else if (source.ss_family == AF_INET6) {");
    cg_em(g, "        *source_port = ntohs(((struct sockaddr_in6*)&source)->sin6_port);");
    cg_em(g, "    }");
    cg_em(g, "#endif");
    cg_em(g, "    else { return -1; }");
    cg_em(g, "    return (int64_t)received;");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL void* mort_net_tcp_accept(void* raw) {");
    cg_em(g, "    mort_native_socket listener = mort_socket_value(raw);");
    cg_em(g, "    if (listener == MORT_INVALID_SOCKET) { return NULL; }");
    cg_em(g, "    mort_native_socket accepted = accept(listener, NULL, NULL);");
    cg_em(g, "    return accepted == MORT_INVALID_SOCKET ? NULL : mort_socket_wrap(accepted);");
    cg_em(g, "}");
    cg_em(g, "static MORT_NET_INTERNAL void mort_net_socket_close(void* raw) {");
    cg_em(g, "    if (raw == NULL) { return; }");
    cg_em(g, "    struct mort_socket_handle* handle = (struct mort_socket_handle*)raw;");
    cg_em(g, "    mort_native_socket_close(handle->socket);");
    cg_em(g, "    free(handle);");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL int64_t mort_net_socket_send(void* raw, const uint8_t* buffer, uint64_t length) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET || buffer == NULL) { return -1; }");
    cg_em(g, "    int amount = length > 2147483647ULL ? 2147483647 : (int)length;");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    int result = send(socket, (const char*)buffer, amount, 0);");
    cg_em(g, "    return result == SOCKET_ERROR ? -1 : (int64_t)result;");
    cg_em(g, "#else");
    cg_em(g, "    int flags = 0;");
    cg_em(g, "#ifdef MSG_NOSIGNAL");
    cg_em(g, "    flags = MSG_NOSIGNAL;");
    cg_em(g, "#endif");
    cg_em(g, "    ssize_t result = send(socket, buffer, (size_t)amount, flags);");
    cg_em(g, "    return result < 0 ? -1 : (int64_t)result;");
    cg_em(g, "#endif");
    cg_em(g, "}");
    cg_em(g, "static MORT_NET_INTERNAL int64_t mort_net_socket_recv(void* raw, uint8_t* buffer, uint64_t length) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET || buffer == NULL) { return -1; }");
    cg_em(g, "    int amount = length > 2147483647ULL ? 2147483647 : (int)length;");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    int result = recv(socket, (char*)buffer, amount, 0);");
    cg_em(g, "    if (result != SOCKET_ERROR) { return (int64_t)result; }");
    cg_em(g, "    return WSAGetLastError() == WSAEMSGSIZE ? (int64_t)amount : -1;");
    cg_em(g, "#else");
    cg_em(g, "    ssize_t result = recv(socket, buffer, (size_t)amount, 0);");
    cg_em(g, "    return result < 0 ? -1 : (int64_t)result;");
    cg_em(g, "#endif");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL bool mort_net_socket_shutdown(void* raw) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET) { return false; }");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    return shutdown(socket, SD_BOTH) == 0;");
    cg_em(g, "#else");
    cg_em(g, "    return shutdown(socket, SHUT_RDWR) == 0;");
    cg_em(g, "#endif");
    cg_em(g, "}");
    cg_em(g, "static MORT_NET_INTERNAL bool mort_net_socket_set_nonblocking(void* raw, bool enabled) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET) { return false; }");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    u_long mode = enabled ? 1UL : 0UL;");
    cg_em(g, "    return ioctlsocket(socket, FIONBIO, &mode) == 0;");
    cg_em(g, "#else");
    cg_em(g, "    int flags = fcntl(socket, F_GETFL, 0);");
    cg_em(g, "    if (flags < 0) { return false; }");
    cg_em(g, "    int next = enabled ? (flags | O_NONBLOCK) : (flags & ~O_NONBLOCK);");
    cg_em(g, "    return fcntl(socket, F_SETFL, next) == 0;");
    cg_em(g, "#endif");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL int32_t mort_net_socket_wait(void* raw, uint32_t events, int64_t timeout_millis) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET || (events & 3U) == 0U || timeout_millis < -1) { return -1; }");
    cg_em(g, "    int timeout = timeout_millis > 2147483647LL ? 2147483647 : (int)timeout_millis;");
    cg_em(g, "    int32_t ready = 0;");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    WSAPOLLFD descriptor;");
    cg_em(g, "    descriptor.fd = socket;");
    cg_em(g, "    descriptor.events = 0;");
    cg_em(g, "    descriptor.revents = 0;");
    cg_em(g, "    if ((events & 1U) != 0U) { descriptor.events |= POLLRDNORM; }");
    cg_em(g, "    if ((events & 2U) != 0U) { descriptor.events |= POLLWRNORM; }");
    cg_em(g, "    int result = WSAPoll(&descriptor, 1, timeout);");
    cg_em(g, "    if (result == SOCKET_ERROR) { return -1; }");
    cg_em(g, "    if (result == 0) { return 0; }");
    cg_em(g, "    if ((descriptor.revents & POLLRDNORM) != 0) { ready |= 1; }");
    cg_em(g, "    if ((descriptor.revents & POLLWRNORM) != 0) { ready |= 2; }");
    cg_em(g, "    if ((descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) { ready |= 4; }");
    cg_em(g, "#else");
    cg_em(g, "    struct pollfd descriptor;");
    cg_em(g, "    descriptor.fd = socket;");
    cg_em(g, "    descriptor.events = 0;");
    cg_em(g, "    descriptor.revents = 0;");
    cg_em(g, "    if ((events & 1U) != 0U) { descriptor.events |= POLLIN; }");
    cg_em(g, "    if ((events & 2U) != 0U) { descriptor.events |= POLLOUT; }");
    cg_em(g, "    int result;");
    cg_em(g, "    do {");
    cg_em(g, "        result = poll(&descriptor, 1, timeout);");
    cg_em(g, "    } while (result < 0 && errno == EINTR);");
    cg_em(g, "    if (result < 0) { return -1; }");
    cg_em(g, "    if (result == 0) { return 0; }");
    cg_em(g, "    if ((descriptor.revents & POLLIN) != 0) { ready |= 1; }");
    cg_em(g, "    if ((descriptor.revents & POLLOUT) != 0) { ready |= 2; }");
    cg_em(g, "    if ((descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) { ready |= 4; }");
    cg_em(g, "#endif");
    cg_em(g, "    return ready;");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL bool mort_net_last_error_would_block(void) {");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    return WSAGetLastError() == WSAEWOULDBLOCK;");
    cg_em(g, "#else");
    cg_em(g, "    return errno == EAGAIN || errno == EWOULDBLOCK;");
    cg_em(g, "#endif");
    cg_em(g, "}");
    cg_em(g, "");
    cg_em(g, "static MORT_NET_INTERNAL uint16_t mort_net_socket_local_port(void* raw) {");
    cg_em(g, "    mort_native_socket socket = mort_socket_value(raw);");
    cg_em(g, "    if (socket == MORT_INVALID_SOCKET) { return 0; }");
    cg_em(g, "    struct sockaddr_storage address;");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    int length = (int)sizeof(address);");
    cg_em(g, "#else");
    cg_em(g, "    socklen_t length = (socklen_t)sizeof(address);");
    cg_em(g, "#endif");
    cg_em(g, "    if (getsockname(socket, (struct sockaddr*)&address, &length) != 0) { return 0; }");
    cg_em(g, "    if (address.ss_family == AF_INET) {");
    cg_em(g, "        return ntohs(((struct sockaddr_in*)&address)->sin_port);");
    cg_em(g, "    }");
    cg_em(g, "#ifdef AF_INET6");
    cg_em(g, "    if (address.ss_family == AF_INET6) {");
    cg_em(g, "        return ntohs(((struct sockaddr_in6*)&address)->sin6_port);");
    cg_em(g, "    }");
    cg_em(g, "#endif");
    cg_em(g, "    return 0;");
    cg_em(g, "}");
    cg_em(g, "#undef MORT_NET_INTERNAL");
    cg_em(g, "");
}

fn cgt_secure_random(g: *Cg) {
    cg_em(g, "#if defined(__GNUC__) || defined(__clang__)");
    cg_em(g, "#define MORT_RANDOM_INTERNAL __attribute__((unused))");
    cg_em(g, "#else");
    cg_em(g, "#define MORT_RANDOM_INTERNAL");
    cg_em(g, "#endif");
    cg_em(g, "static MORT_RANDOM_INTERNAL bool mort_secure_random_fill(uint8_t* buffer, uint64_t length) {");
    cg_em(g, "    if (buffer == NULL) { return length == 0; }");
    cg_em(g, "#ifdef _WIN32");
    cg_em(g, "    while (length > 0) {");
    cg_em(g, "        ULONG amount = length > 4294967295ULL ? 4294967295UL : (ULONG)length;");
    cg_em(g, "        NTSTATUS status = BCryptGenRandom(NULL, buffer, amount, BCRYPT_USE_SYSTEM_PREFERRED_RNG);");
    cg_em(g, "        if (!BCRYPT_SUCCESS(status)) { return false; }");
    cg_em(g, "        buffer += amount;");
    cg_em(g, "        length -= amount;");
    cg_em(g, "    }");
    cg_em(g, "    return true;");
    cg_em(g, "#else");
    cg_em(g, "    int descriptor = open(\"/dev/urandom\", O_RDONLY);");
    cg_em(g, "    if (descriptor < 0) { return false; }");
    cg_em(g, "    while (length > 0) {");
    cg_em(g, "        size_t amount = length > (uint64_t)SIZE_MAX ? SIZE_MAX : (size_t)length;");
    cg_em(g, "        ssize_t received = read(descriptor, buffer, amount);");
    cg_em(g, "        if (received < 0 && errno == EINTR) { continue; }");
    cg_em(g, "        if (received <= 0) {");
    cg_em(g, "            close(descriptor);");
    cg_em(g, "            return false;");
    cg_em(g, "        }");
    cg_em(g, "        buffer += (size_t)received;");
    cg_em(g, "        length -= (uint64_t)received;");
    cg_em(g, "    }");
    cg_em(g, "    return close(descriptor) == 0;");
    cg_em(g, "#endif");
    cg_em(g, "}");
    cg_em(g, "#undef MORT_RANDOM_INTERNAL");
    cg_em(g, "");
}
