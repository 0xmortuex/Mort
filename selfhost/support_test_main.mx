// Test driver for support.mx, run by test_support.py.
//
//   support_test_main run OPS OUT    run the operations in OPS, write results to OUT
//   support_test_main fatal NAME     run one scenario that must end the process
//
// OPS has one operation per line: a name and space-separated operands. Numbers
// are decimal and byte strings are lowercase hex, so any byte is expressible.
// Results are one per line. test_support.py computes the expected lines with a
// Python model of the same operations.

import support;

struct State {
    out: Buf,
    bytes: Buf,
    numbers: U64Vec,
    pointers: PtrVec,
    table: Map,
    names: Interner,
    kept: Span,
}

struct Cursor {
    data: *u8,
    len: u64,
    at: u64,
}

fn read_all(path: *u8) -> Buf {
    let handle = file_open(path, "rb");
    if handle == (0 as *void) {
        sup_die("support_test_main: cannot read the operations file");
    }
    let contents = buf_new(4096);
    let chunk = sup_alloc(65536) as *u8;
    loop {
        let got = file_read(handle, chunk, 65536);
        if got == 0 {
            break;
        }
        for i: u64 in 0..got {
            buf_push(&contents, chunk[i]);
        }
    }
    file_close(handle);
    return contents;
}

fn next_word(c: *Cursor) -> Span {
    let start = (*c).at;
    while (*c).at < (*c).len && (*c).data[(*c).at] != ' ' && (*c).data[(*c).at] != 10 {
        (*c).at += 1;
    }
    let word = Span { data: &(*c).data[start], len: (*c).at - start };
    if (*c).at < (*c).len && (*c).data[(*c).at] == ' ' {
        (*c).at += 1;
    }
    return word;
}

fn end_line(c: *Cursor) {
    if (*c).at >= (*c).len || (*c).data[(*c).at] != 10 {
        sup_die("support_test_main: expected the end of the operation line");
    }
    (*c).at += 1;
}

fn parse_number(c: *Cursor) -> u64 {
    let word = next_word(c);
    if word.len == 0 {
        sup_die("support_test_main: expected a number");
    }
    let value: u64 = 0;
    for i: u64 in 0..word.len {
        value = value * 10 + (word.data[i] - 48) as u64;
    }
    return value;
}

fn hex_value(digit: u8) -> u8 {
    if digit >= 'a' {
        return digit - 'a' + 10;
    }
    return digit - '0';
}

// Decode the next word into a fresh allocation, zero-terminated past its length.
fn parse_hex(c: *Cursor) -> Span {
    let word = next_word(c);
    let n = word.len / 2;
    let data = sup_alloc(n + 1) as *u8;
    for i: u64 in 0..n {
        data[i] = (hex_value(word.data[2 * i]) << 4) | hex_value(word.data[2 * i + 1]);
    }
    data[n] = 0;
    return Span { data: data, len: n };
}

fn emit_u64(st: *State, value: u64) {
    buf_push_u64(&(*st).out, value);
    buf_push(&(*st).out, 10);
}

fn emit_hex(st: *State, s: Span) {
    if s.len == 0 {
        buf_push(&(*st).out, '-');
    }
    for i: u64 in 0..s.len {
        buf_push(&(*st).out, hex_digit(s.data[i] >> 4));
        buf_push(&(*st).out, hex_digit(s.data[i] & 15));
    }
    buf_push(&(*st).out, 10);
}

fn hex_digit(nibble: u8) -> u8 {
    if nibble < 10 {
        return '0' + nibble;
    }
    return 'a' + nibble - 10;
}

fn run_buffer_op(st: *State, name: Span, c: *Cursor) -> bool {
    if span_eq_z(name, "buf_new") {
        (*st).bytes = buf_new(parse_number(c));
    } else if span_eq_z(name, "buf_push") {
        let bytes = parse_hex(c);
        for i: u64 in 0..bytes.len {
            buf_push(&(*st).bytes, bytes.data[i]);
        }
    } else if span_eq_z(name, "buf_push_z") {
        let bytes = parse_hex(c);
        buf_push_z(&(*st).bytes, bytes.data);
    } else if span_eq_z(name, "buf_push_span") {
        buf_push_span(&(*st).bytes, parse_hex(c));
    } else if span_eq_z(name, "buf_push_u64") {
        buf_push_u64(&(*st).bytes, parse_number(c));
    } else if span_eq_z(name, "buf_show") {
        emit_hex(st, buf_span(&(*st).bytes));
    } else {
        return false;
    }
    return true;
}

fn run_vector_op(st: *State, name: Span, c: *Cursor) -> bool {
    if span_eq_z(name, "vec_new") {
        (*st).numbers = u64vec_new();
    } else if span_eq_z(name, "vec_push") {
        u64vec_push(&(*st).numbers, parse_number(c));
    } else if span_eq_z(name, "vec_get") {
        emit_u64(st, u64vec_get(&(*st).numbers, parse_number(c)));
    } else if span_eq_z(name, "vec_set") {
        let index = parse_number(c);
        u64vec_set(&(*st).numbers, index, parse_number(c));
    } else if span_eq_z(name, "vec_pop") {
        emit_u64(st, u64vec_pop(&(*st).numbers));
    } else if span_eq_z(name, "vec_len") {
        emit_u64(st, (*st).numbers.len);
    } else if span_eq_z(name, "ptr_new") {
        (*st).pointers = ptrvec_new();
    } else if span_eq_z(name, "ptr_push") {
        ptrvec_push(&(*st).pointers, new_cell(parse_number(c)));
    } else if span_eq_z(name, "ptr_get") {
        emit_u64(st, *(ptrvec_get(&(*st).pointers, parse_number(c)) as *u64));
    } else if span_eq_z(name, "ptr_set") {
        let index = parse_number(c);
        ptrvec_set(&(*st).pointers, index, new_cell(parse_number(c)));
    } else if span_eq_z(name, "ptr_pop") {
        emit_u64(st, *(ptrvec_pop(&(*st).pointers) as *u64));
    } else if span_eq_z(name, "ptr_len") {
        emit_u64(st, (*st).pointers.len);
    } else {
        return false;
    }
    return true;
}

fn run_map_op(st: *State, name: Span, c: *Cursor) -> bool {
    if span_eq_z(name, "map_new") {
        (*st).table = map_new();
    } else if span_eq_z(name, "map_put") {
        let key = parse_number(c);
        map_put(&(*st).table, key, parse_number(c));
    } else if span_eq_z(name, "map_get") {
        let value: u64 = 0;
        if map_get(&(*st).table, parse_number(c), &value) {
            emit_u64(st, value);
        } else {
            buf_push_z(&(*st).out, "none");
            buf_push(&(*st).out, 10);
        }
    } else if span_eq_z(name, "map_has") {
        if map_has(&(*st).table, parse_number(c)) {
            emit_u64(st, 1);
        } else {
            emit_u64(st, 0);
        }
    } else if span_eq_z(name, "map_len") {
        emit_u64(st, map_len(&(*st).table));
    } else {
        return false;
    }
    return true;
}

fn run_intern_op(st: *State, name: Span, c: *Cursor) -> bool {
    if span_eq_z(name, "intern_new") {
        (*st).names = intern_new();
    } else if span_eq_z(name, "intern") {
        emit_u64(st, intern(&(*st).names, parse_hex(c)));
    } else if span_eq_z(name, "intern_z") {
        emit_u64(st, intern_z(&(*st).names, parse_hex(c).data));
    } else if span_eq_z(name, "intern_hashed") {
        let hash = parse_number(c);
        emit_u64(st, intern_hashed(&(*st).names, parse_hex(c), hash));
    } else if span_eq_z(name, "intern_hash") {
        emit_u64(st, intern_hash(parse_hex(c)));
    } else if span_eq_z(name, "intern_text") {
        let text = intern_text(&(*st).names, parse_number(c));
        emit_hex(st, text);
        emit_u64(st, text.data[text.len] as u64);
    } else if span_eq_z(name, "intern_keep") {
        (*st).kept = intern_text(&(*st).names, parse_number(c));
    } else if span_eq_z(name, "intern_show_kept") {
        emit_hex(st, (*st).kept);
    } else if span_eq_z(name, "intern_count") {
        emit_u64(st, intern_count(&(*st).names));
    } else {
        return false;
    }
    return true;
}

fn run_diagnostic_op(st: *State, name: Span, c: *Cursor) -> bool {
    if !span_eq_z(name, "diag") {
        return false;
    }
    let line = parse_number(c);
    let col = parse_number(c);
    let path = parse_hex(c);
    let message = parse_hex(c);
    let text = buf_new(64);
    diag_format(&text, path.data, line, col, message);
    emit_hex(st, buf_span(&text));
    return true;
}

fn new_cell(value: u64) -> *void {
    let cell = sup_alloc(sizeof<u64>()) as *u64;
    *cell = value;
    return cell as *void;
}

fn new_state() -> State {
    return State {
        out: buf_new(4096),
        bytes: buf_new(16),
        numbers: u64vec_new(),
        pointers: ptrvec_new(),
        table: map_new(),
        names: intern_new(),
        kept: Span { data: 0 as *u8, len: 0 },
    };
}

fn run_ops(ops_path: *u8, out_path: *u8) -> int {
    let script = read_all(ops_path);
    let cursor = Cursor { data: script.data, len: script.len, at: 0 };
    let state = new_state();
    while cursor.at < cursor.len {
        let name = next_word(&cursor);
        if !run_buffer_op(&state, name, &cursor)
            && !run_vector_op(&state, name, &cursor)
            && !run_map_op(&state, name, &cursor)
            && !run_intern_op(&state, name, &cursor)
            && !run_diagnostic_op(&state, name, &cursor) {
            sup_die("support_test_main: unknown operation");
        }
        end_line(&cursor);
    }
    let handle = file_open(out_path, "wb");
    if handle == (0 as *void) {
        sup_die("support_test_main: cannot write the output file");
    }
    if file_write(handle, state.out.data, state.out.len) != state.out.len {
        sup_die("support_test_main: short write to the output file");
    }
    file_close(handle);
    return 0;
}

fn run_fatal(name: Span) -> int {
    let numbers = u64vec_new();
    let pointers = ptrvec_new();
    u64vec_push(&numbers, 7);
    ptrvec_push(&pointers, new_cell(7));
    if span_eq_z(name, "vec_get_past_end") {
        u64vec_get(&numbers, 1);
    } else if span_eq_z(name, "vec_get_huge") {
        u64vec_get(&numbers, 0xFFFFFFFFFFFFFFFF);
    } else if span_eq_z(name, "vec_set_past_end") {
        u64vec_set(&numbers, 1, 0);
    } else if span_eq_z(name, "vec_pop_empty") {
        u64vec_pop(&numbers);
        u64vec_pop(&numbers);
    } else if span_eq_z(name, "ptr_get_past_end") {
        ptrvec_get(&pointers, 1);
    } else if span_eq_z(name, "ptr_set_past_end") {
        ptrvec_set(&pointers, 1, 0 as *void);
    } else if span_eq_z(name, "ptr_pop_empty") {
        ptrvec_pop(&pointers);
        ptrvec_pop(&pointers);
    } else if span_eq_z(name, "intern_text_bad") {
        let names = intern_new();
        intern_z(&names, "only");
        intern_text(&names, 1);
    } else if span_eq_z(name, "diag_fatal") {
        diag_fatal("dir/input.mx", 2, 7, span_z("something is wrong"));
    } else if span_eq_z(name, "diag_report") {
        diag_report("dir/input.mx", 3, 1, span_z("first problem"));
        diag_report("dir/input.mx", 4, 1, span_z("second problem"));
        println("continued");
        return 0;
    } else if span_eq_z(name, "alloc_impossible") {
        sup_alloc(0xFFFFFFFFFFFFFFF0);
    } else if span_eq_z(name, "alloc_array_overflow") {
        sup_alloc_array(0x2000000000000000, 8);
    } else {
        sup_die("support_test_main: unknown fatal scenario");
    }
    println("support_test_main: the scenario returned");
    return 0;
}

fn main() -> int {
    if arg_count() == 4 && span_eq_z(span_z(arg_get(1)), "run") {
        return run_ops(arg_get(2), arg_get(3));
    }
    if arg_count() == 3 && span_eq_z(span_z(arg_get(1)), "fatal") {
        return run_fatal(span_z(arg_get(2)));
    }
    sup_die("usage: support_test_main run OPS OUT | fatal NAME");
    return 2;
}
