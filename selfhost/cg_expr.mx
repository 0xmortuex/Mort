// C code generator: expressions (PLAN.md, T7). A port of mort/codegen.py's
// _gen_expr, _gen_cast and _c_int_literal, byte for byte, including the order of
// Python's evaluation: `self.strings` numbering, helper use and work charges happen
// in the same sequence, so an `obj[index]` generates its index first.
//
// Text is built in double-ended buffers (`Txt`). A left-deep expression grows at
// both ends around its left operand, so wrapping it costs only the wrapper and not
// a copy of everything underneath, and a 300,000-operand chain stays linear.
//
// The left spine (Binary.left, Cast.expr, FieldAccess.obj, Index.obj) has no depth
// limit, so `cg_gx` walks it with an explicit stack. Every other operand recurses
// and is bounded by the parser's MAX_NESTING.
//
// Two things in Python double per nesting level. A slice operand without a prepared
// temporary is written twice, and a `slice` or `len` of a slice generates its
// arguments twice. Mort charges what is really produced, so anything Python compiles
// at a sensible size is accepted: a large duplicated operand is one shared token that
// expands when the output is written, and a second generation that has no effect
// reuses the first text. Only output that would be enormous is reported.
//
// Array repeats that make more than CG_BIG_REPEAT bytes of text are not expanded in
// memory. They stay a short token in every buffer and expand when the output is
// written, since Python's own limit allows 256 MB of them.

import support;
import ast;
import typestr;
import bignum;
import checker;
import check_expr;
import check_call;
import codegen;
import cg_helpers;
import cg_stmt;
import cg_float;

// `MAX_ARRAY_REPEAT_BYTES` and `_ZERO_REPEAT_MIN` in mort/codegen.py.
const CG_MAX_ARRAY_REPEAT_BYTES: u64 = 268435456;
const CG_ZERO_REPEAT_MIN: u64 = 256;

// Above this a repeat's text is held as a token until the output is written.
const CG_BIG_REPEAT: u64 = 1048576;
// Limits on what Python leaves unbounded; see the header. They bound output Python
// cannot produce at a sensible size either: a gigabyte of duplicated text, and the
// string table and generation work of doubled literals.
const CG_MAX_DUPLICATED_TEXT: u64 = 1073741824;
const CG_MAX_STRINGS: u64 = 8000000;
const CG_MAX_REGENERATED_NODES: u64 = 256000000;
// Bytes the writer buffers between calls to file_write.
const CG_WRITE_CHUNK: u64 = 1048576;

// ----- double-ended text -----

struct Txt {
    base: *u8,
    cap: u64,
    head: u64,
    tail: u64,
}

fn tx_new(room: u64) -> *Txt {
    let t = sup_alloc(sizeof<Txt>()) as *Txt;
    let cap = room * 2 + 32;
    *t = Txt { base: sup_alloc(cap) as *u8, cap: cap, head: cap / 2, tail: cap / 2 };
    return t;
}

fn tx_free(t: *Txt) {
    free((*t).base as *void);
    free(t as *void);
}

fn tx_len(t: *Txt) -> u64 {
    return (*t).tail - (*t).head;
}

fn tx_span(t: *Txt) -> Span {
    return Span { data: &(*t).base[(*t).head], len: (*t).tail - (*t).head };
}

// Makes room for `front` bytes before and `back` bytes after the text. Doubling on
// both sides keeps a long run of prepends and appends amortized linear.
fn tx_room(t: *Txt, front: u64, back: u64) {
    if (*t).head >= front && (*t).cap - (*t).tail >= back {
        return;
    }
    let len = tx_len(t);
    let cap = (len + front + back) * 2 + 32;
    let base = sup_alloc(cap) as *u8;
    let head = front + (cap - len - front - back) / 2;
    for i: u64 in 0..len {
        base[head + i] = (*t).base[(*t).head + i];
    }
    free((*t).base as *void);
    (*t).base = base;
    (*t).cap = cap;
    (*t).head = head;
    (*t).tail = head + len;
}

fn tx_app_span(t: *Txt, s: Span) {
    tx_room(t, 0, s.len);
    for i: u64 in 0..s.len {
        (*t).base[(*t).tail + i] = s.data[i];
    }
    (*t).tail += s.len;
}

fn tx_app_z(t: *Txt, text: *u8) {
    tx_app_span(t, span_z(text));
}

fn tx_app_u64(g: *Cg, t: *Txt, value: u64) {
    (*g).scratch.len = 0;
    buf_push_u64(&(*g).scratch, value);
    tx_app_span(t, buf_span(&(*g).scratch));
}

fn tx_pre_span(t: *Txt, s: Span) {
    tx_room(t, s.len, 0);
    (*t).head -= s.len;
    for i: u64 in 0..s.len {
        (*t).base[(*t).head + i] = s.data[i];
    }
}

fn tx_pre_z(t: *Txt, text: *u8) {
    tx_pre_span(t, span_z(text));
}

// Moves `other`'s text to the end of `t` and frees `other`.
fn tx_app_txt(t: *Txt, other: *Txt) {
    tx_app_span(t, tx_span(other));
    tx_free(other);
}

fn cg_new_text(g: *Cg, text: Span) -> *Txt {
    let t = tx_new(text.len);
    tx_app_span(t, text);
    return t;
}

fn cg_new_z(text: *u8) -> *Txt {
    let t = tx_new(32);
    tx_app_z(t, text);
    return t;
}

// The scratch line used to build a prefix before it is prepended in one piece.
fn cg_scratch_reset(g: *Cg) -> *Buf {
    (*g).scratch.len = 0;
    return &(*g).scratch;
}

fn cg_pre_scratch(g: *Cg, t: *Txt) {
    tx_pre_span(t, buf_span(&(*g).scratch));
}

fn cg_limit_fail(g: *Cg, e: *Node, message: Span) {
    ck_exit_diag((*g).c, (*e).line, ck_column_of(e), (*e).file, message);
}

// ----- integer text -----

// `_c_int_literal`.
fn cg_c_int_literal(g: *Cg, v: *BigInt, typ: u64) -> *Txt {
    let lit = buf_new(32);
    let value = *v;
    if bn_mag_cmp(value, (*g).i64_max) > 0 {
        if bn_is_negative(value) {
            let pattern = bn_add(value, (*g).two64);
            let text = bn_format(pattern);
            buf_push_z(&lit, text);
            free(text as *void);
            bn_free(pattern);
        } else {
            let text = bn_format(value);
            buf_push_z(&lit, text);
            free(text as *void);
        }
        buf_push_z(&lit, "ULL");
    } else {
        let text = bn_format(value);
        buf_push_z(&lit, text);
        free(text as *void);
        if bn_mag_cmp(value, (*g).i32_max) > 0 {
            buf_push_z(&lit, "LL");
        }
    }
    let t = cg_new_text(g, buf_span(&lit));
    free(lit.data as *void);
    cg_wrap_cast(g, t, typ);
    return t;
}

// `((ct)text)`.
fn cg_wrap_cast(g: *Cg, t: *Txt, typ: u64) {
    let ct = cg_ct_span(g, typ);
    let p = cg_scratch_reset(g);
    buf_push_z(p, "((");
    buf_push_span(p, ct);
    buf_push(p, ')');
    cg_pre_scratch(g, t);
    tx_app_z(t, ")");
}

// `_fixed_wrap` applied to the text in `t`.
fn cg_fixed_wrap(g: *Cg, at: u64, t: *Txt) {
    let p = cg_scratch_reset(g);
    if at < 4 {
        cg_use_int(g, CG_OP_WRAP, at);
        buf_push_z(p, "mort_wrap_");
        cg_fixed_name(p, at);
        buf_push(p, '(');
    } else {
        buf_push_z(p, "((");
        cg_fixed_ctype(p, at);
        buf_push(p, ')');
    }
    buf_push_z(p, "((");
    cg_fixed_unsigned(p, at);
    buf_push_z(p, ")(");
    cg_pre_scratch(g, t);
    tx_app_z(t, ")))");
}

// `_fixed_unary`.
fn cg_fixed_unary(g: *Cg, at: u64, negate: bool, t: *Txt) {
    let p = cg_scratch_reset(g);
    if negate {
        buf_push_z(p, "((");
        cg_fixed_promoted(p, at);
        buf_push_z(p, ")0 - (");
    } else {
        buf_push_z(p, "(~(");
    }
    cg_fixed_promoted(p, at);
    buf_push_z(p, ")((");
    cg_fixed_unsigned(p, at);
    buf_push_z(p, ")(");
    cg_pre_scratch(g, t);
    tx_app_z(t, ")))");
    cg_fixed_wrap(g, at, t);
}

// `_fixed_binary`: `left` holds the left operand and receives the result.
fn cg_fixed_binary(g: *Cg, typ: u64, op: Span, left: *Txt, right: Span, line: u64) {
    let at = cg_fixed_index(g, typ);
    if span_eq_z(op, "/") || span_eq_z(op, "%") {
        let div = span_eq_z(op, "/");
        if div {
            cg_use_int(g, CG_OP_DIV, at);
        } else {
            cg_use_int(g, CG_OP_REM, at);
        }
        let ctype = cg_ct_span(g, typ);
        let p = cg_scratch_reset(g);
        buf_push_z(p, "mort_");
        if div {
            buf_push_z(p, "div_");
        } else {
            buf_push_z(p, "rem_");
        }
        cg_fixed_name(p, at);
        buf_push_z(p, "((");
        buf_push_span(p, ctype);
        buf_push_z(p, ")(");
        cg_pre_scratch(g, left);
        tx_app_z(left, "), (");
        tx_app_span(left, ctype);
        tx_app_z(left, ")(");
        tx_app_span(left, right);
        tx_app_z(left, "), ");
        tx_app_u64(g, left, line);
        tx_app_z(left, ")");
        return;
    }
    let p = cg_scratch_reset(g);
    buf_push_z(p, "((");
    cg_fixed_promoted(p, at);
    buf_push_z(p, ")((");
    cg_fixed_unsigned(p, at);
    buf_push_z(p, ")(");
    cg_pre_scratch(g, left);
    tx_app_z(left, ")) ");
    tx_app_span(left, op);
    tx_app_z(left, " (");
    let q = cg_scratch_reset(g);
    cg_fixed_promoted(q, at);
    buf_push_z(q, ")((");
    cg_fixed_unsigned(q, at);
    buf_push_z(q, ")(");
    tx_app_span(left, buf_span(q));
    tx_app_span(left, right);
    tx_app_z(left, ")))");
    cg_fixed_wrap(g, at, left);
}

// `_fixed_shift`.
fn cg_fixed_shift(g: *Cg, typ: u64, op: Span, left: *Txt, right: Span, right_type: u64,
        line: u64) {
    let at = cg_fixed_index(g, typ);
    let shl = span_eq_z(op, "<<");
    if shl {
        cg_use_int(g, CG_OP_SHL, at);
    } else {
        cg_use_int(g, CG_OP_SHR, at);
    }
    let signed_count = cg_is_signed_count(g, right_type);
    if signed_count {
        (*g).used_shift_count = true;
    }
    let ctype = cg_ct_span(g, typ);
    let p = cg_scratch_reset(g);
    if shl {
        buf_push_z(p, "mort_shl_");
    } else {
        buf_push_z(p, "mort_shr_");
    }
    cg_fixed_name(p, at);
    buf_push_z(p, "((");
    buf_push_span(p, ctype);
    buf_push_z(p, ")(");
    cg_pre_scratch(g, left);
    tx_app_z(left, "), ");
    if signed_count {
        tx_app_z(left, "mort_shift_count_signed((int64_t)(");
        tx_app_span(left, right);
        tx_app_z(left, "), ");
        tx_app_u64(g, left, line);
        tx_app_z(left, ")");
    } else {
        tx_app_z(left, "((uint64_t)(");
        tx_app_span(left, right);
        tx_app_z(left, "))");
    }
    tx_app_z(left, ")");
}

// `_gen_cast`, once its operand is in `t`.
fn cg_compose_cast(g: *Cg, e: *Node, t: *Txt) {
    let target = (*e).ty;
    let at = cg_fixed_index(g, target);
    if at == CG_FIXED_COUNT {
        cg_wrap_cast(g, t, target);
        return;
    }
    let source_type = cg_text(g, (*(*e).a).etype);
    if span_eq_z(source_type, "f32") || span_eq_z(source_type, "f64") {
        cg_use_int(g, CG_OP_FLOAT_CAST, at);
        let p = cg_scratch_reset(g);
        buf_push_z(p, "mort_float_to_");
        cg_fixed_name(p, at);
        buf_push_z(p, "((double)(");
        cg_pre_scratch(g, t);
        tx_app_z(t, "), ");
        tx_app_u64(g, t, (*e).line);
        tx_app_z(t, ")");
        return;
    }
    if ts_starts_with(source_type, "*") {
        tx_pre_z(t, "((uintptr_t)(");
        tx_app_z(t, "))");
    }
    cg_fixed_wrap(g, at, t);
}

// `Binary`: the left operand is in `t`.
fn cg_compose_binary(g: *Cg, e: *Node, t: *Txt) {
    let right = cg_gx(g, (*e).b);
    let op = cg_text(g, (*e).name);
    let right_span = tx_span(right);
    if cg_fixed_index(g, (*e).etype) != CG_FIXED_COUNT && cg_fixed_op(op) {
        if span_eq_z(op, "<<") || span_eq_z(op, ">>") {
            cg_fixed_shift(g, (*e).etype, op, t, right_span, (*(*e).b).etype, (*e).line);
        } else {
            cg_fixed_binary(g, (*e).etype, op, t, right_span, (*e).line);
        }
    } else {
        tx_pre_z(t, "(");
        tx_app_z(t, " ");
        tx_app_span(t, op);
        tx_app_z(t, " ");
        tx_app_span(t, right_span);
        tx_app_z(t, ")");
    }
    tx_free(right);
}

fn cg_fixed_op(op: Span) -> bool {
    return span_eq_z(op, "+") || span_eq_z(op, "-") || span_eq_z(op, "*") || span_eq_z(op, "/")
        || span_eq_z(op, "%") || span_eq_z(op, "&") || span_eq_z(op, "|") || span_eq_z(op, "^")
        || span_eq_z(op, "<<") || span_eq_z(op, ">>");
}

// ----- field access and indexing -----

// Whether `FieldAccess` reads a value, as opposed to naming a function or an enum
// variant; a value access has an object expression that is generated.
fn cg_field_is_value(g: *Cg, e: *Node) -> bool {
    if (*e).resolved_fn != NO_TEXT {
        return false;
    }
    let obj = (*e).a;
    return !((*obj).kind == NodeKind.VAR && map_has(&(*g).enum_names, (*obj).name));
}

fn cg_compose_field(g: *Cg, e: *Node, t: *Txt) {
    let field = cg_text(g, (*e).name);
    tx_pre_z(t, "(");
    if ts_is_slice((*g).s, (*(*e).a).etype) {
        tx_app_z(t, ").");
        if span_eq_z(field, "len") {
            tx_app_z(t, "length");
        } else {
            tx_app_span(t, field);
        }
        return;
    }
    tx_app_z(t, ").f_");
    tx_app_span(t, field);
}

// Moves `t`'s text out to a shared token, so writing it twice costs a reference.
fn cg_share_text(g: *Cg, t: *Txt) {
    let value = tx_span(t);
    let bytes = cg_true_len(g, value);
    let index = cg_add_big(g, value, 1, bytes, CG_BIG_SHARED);
    let cap: u64 = 64;
    (*t).base = sup_alloc(cap) as *u8;
    (*t).cap = cap;
    (*t).head = cap / 2;
    (*t).tail = cap / 2;
    tx_app_token(g, t, index);
}

fn cg_push_token(g: *Cg, b: *Buf, index: u64) {
    buf_push_span(b, Span { data: &(*g).token_mark[0], len: 1 });
    buf_push_u64(b, index);
    buf_push_span(b, Span { data: &(*g).token_mark[0], len: 1 });
}

fn tx_app_token(g: *Cg, t: *Txt, index: u64) {
    tx_app_span(t, Span { data: &(*g).token_mark[0], len: 1 });
    tx_app_u64(g, t, index);
    tx_app_span(t, Span { data: &(*g).token_mark[0], len: 1 });
}

// Python's `_tuple_parts(e.obj.type)`, which only charges on the way to the same text.
fn cg_charge_tuple_parts(g: *Cg, obj_type: u64) {
    if !ts_starts_with(cg_text(g, obj_type), "(") {
        return;
    }
    let parts = u64vec_new();
    ck_tuple_parts((*g).c, obj_type, &parts);
    free(parts.data as *void);
}

// A prepared slice index: its object is the temporary, nothing else is generated.
fn cg_slice_index_temp(g: *Cg, e: *Node, index: *Txt) -> *Txt {
    let name = buf_new(32);
    buf_push_z(&name, "mort_index_obj_");
    buf_push_u64(&name, (*e).num - 1);
    let t = cg_new_text(g, buf_span(&name));
    cg_compose_slice_index(g, e, t, buf_span(&name), index);
    free(name.data as *void);
    return t;
}

// `(obj).data[mort_bounds((uint64_t)(index), (obj).length, line)]`. `t` holds `obj`.
fn cg_compose_slice_index(g: *Cg, e: *Node, t: *Txt, obj: Span, index: *Txt) {
    tx_pre_z(t, "(");
    tx_app_z(t, ").data[");
    if (*g).freestanding {
        tx_app_txt(t, index);
    } else {
        (*g).flags[CgFlag.BOUNDS as u64] = true;
        tx_app_z(t, "mort_bounds((uint64_t)(");
        tx_app_txt(t, index);
        tx_app_z(t, "), (");
        tx_app_span(t, obj);
        tx_app_z(t, ").length, ");
        tx_app_u64(g, t, (*e).line);
        tx_app_z(t, ")");
    }
    tx_app_z(t, "]");
}

// An unprepared slice index writes its object twice, so nesting doubles the text.
fn cg_charge_duplicate(g: *Cg, e: *Node, text_len: u64) {
    (*g).duplicated_text += text_len;
    if (*g).duplicated_text > CG_MAX_DUPLICATED_TEXT {
        let msg = m_new();
        m_s(&msg, "duplicated slice operands exceed the limit of ");
        m_u(&msg, CG_MAX_DUPLICATED_TEXT);
        m_s(&msg, " bytes of generated text in one program");
        cg_limit_fail(g, e, buf_span(&msg));
    }
}

fn cg_compose_index(g: *Cg, e: *Node, t: *Txt, index: *Txt) {
    if ts_is_slice((*g).s, (*(*e).a).etype) {
        cg_charge_duplicate(g, e, cg_true_len(g, tx_span(t)));
        if tx_len(t) > CG_BIG_REPEAT {
            cg_share_text(g, t);
        }
        let obj = buf_new(tx_len(t) + 1);
        buf_push_span(&obj, tx_span(t));
        cg_compose_slice_index(g, e, t, buf_span(&obj), index);
        free(obj.data as *void);
        return;
    }
    tx_app_z(t, "[");
    tx_app_txt(t, index);
    tx_app_z(t, "]");
}

// Array bounds check, applied to the index before the object is generated.
fn cg_array_index(g: *Cg, e: *Node, index: *Txt) {
    let obj_type = (*(*e).a).etype;
    if !ts_is_array((*g).s, obj_type) || (*g).freestanding || (*(*e).b).cv != (0 as *void) {
        return;
    }
    (*g).flags[CgFlag.BOUNDS as u64] = true;
    let elem: u64 = 0;
    let count: u64 = 0;
    ck_array_parts((*g).c, obj_type, &elem, &count);
    tx_pre_z(index, "mort_bounds((uint64_t)(");
    tx_app_z(index, "), ");
    tx_app_span(index, cg_text(g, count));
    tx_app_z(index, ", ");
    tx_app_u64(g, index, (*e).line);
    tx_app_z(index, ")");
}

// ----- the spine -----

fn cg_spine_push(g: *Cg, e: *Node, index: *Txt) {
    ptrvec_push(&(*g).spine, e as *void);
    ptrvec_push(&(*g).spine_index, index as *void);
}

fn cg_visit(g: *Cg, e: *Node) {
    (*(*g).c).current_node = e;
    if (*g).regen_depth == 0 {
        return;
    }
    (*g).regen_visits += 1;
    if (*g).regen_visits > CG_MAX_REGENERATED_NODES {
        let msg = m_new();
        m_s(&msg, "expressions under nested slice calls are regenerated too many times; the limit is ");
        m_u(&msg, CG_MAX_REGENERATED_NODES);
        m_s(&msg, " nodes in one program");
        cg_limit_fail(g, e, buf_span(&msg));
    }
}

// `_gen_expr`. Python's left operands are generated first and its wrappers last,
// so everything on the spine that matters to evaluation order runs in that order.
fn cg_gx(g: *Cg, root: *Node) -> *Txt {
    let base = (*g).spine.len;
    let e = root;
    let t = 0 as *Txt;
    loop {
        cg_visit(g, e);
        let kind = (*e).kind;
        if kind == NodeKind.CAST {
            cg_spine_push(g, e, 0 as *Txt);
            e = (*e).a;
            continue;
        }
        if kind == NodeKind.BINARY && (*e).num == 0 && (*e).cv == (0 as *void) {
            cg_spine_push(g, e, 0 as *Txt);
            e = (*e).a;
            continue;
        }
        if kind == NodeKind.FIELD_ACCESS && cg_field_is_value(g, e) {
            if !ts_is_slice((*g).s, (*(*e).a).etype) {
                cg_charge_tuple_parts(g, (*(*e).a).etype);
            }
            cg_spine_push(g, e, 0 as *Txt);
            e = (*e).a;
            continue;
        }
        if kind == NodeKind.INDEX {
            let index = cg_gx(g, (*e).b);
            if ts_is_slice((*g).s, (*(*e).a).etype) && (*e).num != 0 {
                t = cg_slice_index_temp(g, e, index);
                break;
            }
            if !ts_is_slice((*g).s, (*(*e).a).etype) {
                cg_array_index(g, e, index);
            }
            cg_spine_push(g, e, index);
            e = (*e).a;
            continue;
        }
        t = cg_gx_leaf(g, e);
        break;
    }
    while (*g).spine.len > base {
        let n = ptrvec_pop(&(*g).spine) as *Node;
        let index = ptrvec_pop(&(*g).spine_index) as *Txt;
        let kind = (*n).kind;
        if kind == NodeKind.CAST {
            cg_compose_cast(g, n, t);
        } else if kind == NodeKind.BINARY {
            cg_compose_binary(g, n, t);
        } else if kind == NodeKind.FIELD_ACCESS {
            cg_compose_field(g, n, t);
        } else {
            cg_compose_index(g, n, t, index);
        }
    }
    return t;
}

fn cg_function_name(g: *Cg, name: u64) -> *Txt {
    if map_has(&(*g).extern_names, name) {
        return cg_new_text(g, cg_text(g, name));
    }
    let b = buf_new(48);
    buf_push_z(&b, "mort_");
    cg_sym(g, &b, name);
    let t = cg_new_text(g, buf_span(&b));
    free(b.data as *void);
    return t;
}

fn cg_float_text(g: *Cg, e: *Node) -> *Txt {
    let b = buf_new(32);
    cg_push_float_g17(&b, (*e).num);
    let plain = true;
    for i: u64 in 0..b.len {
        if b.data[i] == '.' || b.data[i] == 'e' {
            plain = false;
        }
    }
    if plain {
        buf_push_z(&b, ".0");
    }
    if span_eq_z(cg_text(g, (*e).etype), "f32") {
        buf_push(&b, 'f');
    }
    let t = cg_new_text(g, buf_span(&b));
    free(b.data as *void);
    return t;
}

fn cg_int_above_i64_max(digits: Span) -> bool {
    if digits.len != 19 {
        return digits.len > 19;
    }
    let limit = "9223372036854775807";
    for i: u64 in 0..19 {
        if digits.data[i] != limit[i] {
            return digits.data[i] > limit[i];
        }
    }
    return false;
}

fn cg_int_text(g: *Cg, e: *Node) -> *Txt {
    let digits = cg_text(g, (*e).name);
    if !cg_int_above_i64_max(digits) {
        return cg_new_text(g, digits);
    }
    let t = tx_new(digits.len + 32);
    tx_app_span(t, digits);
    tx_app_z(t, "ULL");
    cg_wrap_cast(g, t, (*e).etype);
    return t;
}

fn cg_string_literal(g: *Cg, e: *Node) -> *Txt {
    let index = (*g).strings.len;
    if index >= CG_MAX_STRINGS {
        let msg = m_new();
        m_s(&msg, "the string table exceeds the limit of ");
        m_u(&msg, CG_MAX_STRINGS);
        m_s(&msg, " entries in one program");
        cg_limit_fail(g, e, buf_span(&msg));
    }
    // Each generation of a literal adds an entry but shares the first one's text.
    let value = (*e).cv as *Span;
    if value == (0 as *Span) {
        let raw = cg_text(g, (*e).name);
        let bytes = sup_alloc(raw.len + 1) as *u8;
        for i: u64 in 0..raw.len {
            bytes[i] = raw.data[i];
        }
        value = sup_alloc(sizeof<Span>()) as *Span;
        *value = Span { data: bytes, len: raw.len };
        (*e).cv = value as *void;
    }
    ptrvec_push(&(*g).strings, value as *void);
    let b = buf_new(32);
    buf_push_z(&b, "mort_str_");
    buf_push_u64(&b, index);
    let t = cg_new_text(g, buf_span(&b));
    free(b.data as *void);
    return t;
}

fn cg_field_leaf(g: *Cg, e: *Node) -> *Txt {
    if (*e).resolved_fn != NO_TEXT {
        return cg_function_name(g, (*e).resolved_fn);
    }
    let enum_name = (*(*e).a).name;
    let tag = cg_text(g, cg_type_tag(g, enum_name));
    let field = cg_text(g, (*e).name);
    let t = tx_new(tag.len * 2 + field.len + 48);
    if map_has(&(*g).payload_enum_names, enum_name) {
        tx_app_z(t, "(struct mort_");
        tx_app_span(t, tag);
        tx_app_z(t, "){ .tag = MORT_");
        tx_app_span(t, tag);
        tx_app_z(t, "_");
        tx_app_span(t, field);
        tx_app_z(t, " }");
    } else {
        tx_app_z(t, "MORT_");
        tx_app_span(t, tag);
        tx_app_z(t, "_");
        tx_app_span(t, field);
    }
    return t;
}

fn cg_struct_literal(g: *Cg, e: *Node) -> *Txt {
    let t = tx_new(64);
    let fields = (*e).items;
    for i: u64 in 0..ck_items_len(fields) {
        let field = ast_item(fields, i);
        if i != 0 {
            tx_app_z(t, ", ");
        }
        tx_app_z(t, ".f_");
        tx_app_span(t, cg_text(g, (*field).name));
        tx_app_z(t, " = ");
        tx_app_txt(t, cg_gx(g, (*field).a));
    }
    let tag = cg_text(g, cg_type_tag(g, (*e).name));
    let p = cg_scratch_reset(g);
    buf_push_z(p, "(struct mort_");
    buf_push_span(p, tag);
    buf_push_z(p, "){ ");
    cg_pre_scratch(g, t);
    tx_app_z(t, " }");
    return t;
}

fn cg_positional_inits(g: *Cg, items: *PtrVec) -> *Txt {
    let t = tx_new(64);
    for i: u64 in 0..ck_items_len(items) {
        if i != 0 {
            tx_app_z(t, ", ");
        }
        tx_app_z(t, ".f_");
        tx_app_u64(g, t, i);
        tx_app_z(t, " = ");
        tx_app_txt(t, cg_gx(g, ast_item(items, i)));
    }
    return t;
}

// Prepends `(<tuple c name>){ ` and appends ` }` around `t`.
fn cg_wrap_tuple_compound(g: *Cg, t: *Txt, tuple_type: u64) {
    let tag = cg_text(g, cg_type_tag(g, tuple_type));
    let p = cg_scratch_reset(g);
    buf_push_z(p, "(struct mort_tuple_");
    buf_push_span(p, tag);
    buf_push_z(p, "){ ");
    cg_pre_scratch(g, t);
    tx_app_z(t, " }");
}

fn cg_array_literal(g: *Cg, e: *Node) -> *Txt {
    let t = tx_new(64);
    tx_app_z(t, "{");
    let items = (*e).items;
    for i: u64 in 0..ck_items_len(items) {
        if i != 0 {
            tx_app_z(t, ", ");
        }
        tx_app_txt(t, cg_gx(g, ast_item(items, i)));
    }
    tx_app_z(t, "}");
    return t;
}

// ----- array repeats -----

const CG_BIG_ARRAY: u64 = 0;
const CG_BIG_SHARED: u64 = 1;
const CG_BIG_STRINGS: u64 = 2;

struct BigRepeat {
    value: Span,
    count: u64,
    bytes: u64,
    kind: u64,
}

fn cg_add_big(g: *Cg, value: Span, count: u64, bytes: u64, kind: u64) -> u64 {
    let big = sup_alloc(sizeof<BigRepeat>()) as *BigRepeat;
    *big = BigRepeat { value: value, count: count, bytes: bytes, kind: kind };
    let index = (*g).big_repeats.len;
    ptrvec_push(&(*g).big_repeats, big as *void);
    return index;
}

fn cg_digits_value(digits: Span) -> u64 {
    let value: u64 = 0;
    for i: u64 in 0..digits.len {
        value = value * 10 + (digits.data[i] - '0') as u64;
    }
    return value;
}

fn cg_is_zero_element(v: Span) -> bool {
    return span_eq_z(v, "0") || span_eq_z(v, "0.0") || span_eq_z(v, "0.0f")
        || span_eq_z(v, "false") || span_eq_z(v, "NULL");
}

const CG_TOKEN_BYTE: u8 = 0xFF;

fn cg_token_at(text: Span, at: u64, index: *u64) -> u64 {
    let value: u64 = 0;
    let i = at + 1;
    while text.data[i] != CG_TOKEN_BYTE {
        value = value * 10 + (text.data[i] - '0') as u64;
        i += 1;
    }
    *index = value;
    return i + 1;
}

// The text length once tokens are expanded, in code points: Python's `len(v)`.
fn cg_true_len(g: *Cg, text: Span) -> u64 {
    let total: u64 = 0;
    let i: u64 = 0;
    while i < text.len {
        if text.data[i] != CG_TOKEN_BYTE {
            if (text.data[i] & 0xC0) != 0x80 {
                total += 1;
            }
            i += 1;
            continue;
        }
        let index: u64 = 0;
        i = cg_token_at(text, i, &index);
        total += (*(ptrvec_get(&(*g).big_repeats, index) as *BigRepeat)).bytes;
    }
    return total;
}

fn cg_repeat_over_limit(g: *Cg, e: *Node) {
    let msg = m_new();
    m_s(&msg, "array repeat of ");
    buf_push_span(&msg, cg_text(g, (*e).name));
    m_s(&msg, " elements pushes the generated initialisers over the ");
    m_u(&msg, CG_MAX_ARRAY_REPEAT_BYTES);
    m_s(&msg, "-byte limit");
    ck_exit_diag((*g).c, (*e).line, (*e).col, (*e).file, buf_span(&msg));
}

fn cg_array_repeat(g: *Cg, e: *Node) -> *Txt {
    let v = cg_gx(g, (*e).a);
    let vs = tx_span(v);
    let count = cg_digits_value(cg_text(g, (*e).name));
    if count > CG_ZERO_REPEAT_MIN && cg_is_zero_element(vs) {
        tx_free(v);
        return cg_new_z("{0}");
    }
    let element = cg_true_len(g, vs);
    let per = element + 2;
    if count > (U64_LIMIT - (*g).array_repeat_bytes) / per {
        cg_repeat_over_limit(g, e);
    }
    (*g).array_repeat_bytes += count * per;
    if (*g).array_repeat_bytes > CG_MAX_ARRAY_REPEAT_BYTES {
        cg_repeat_over_limit(g, e);
    }
    let bytes = count * per;
    if bytes > CG_BIG_REPEAT {
        // The value's text stays alive for the writer.
        let index = cg_add_big(g, vs, count, bytes, CG_BIG_ARRAY);
        let t = tx_new(32);
        tx_app_token(g, t, index);
        return t;
    }
    let t = tx_new(bytes + 8);
    tx_app_z(t, "{");
    for i: u64 in 0..count {
        if i != 0 {
            tx_app_z(t, ", ");
        }
        tx_app_span(t, vs);
    }
    tx_app_z(t, "}");
    tx_free(v);
    return t;
}

// ----- leaves and the rest of the node kinds -----

fn cg_gx_leaf(g: *Cg, e: *Node) -> *Txt {
    let kind = (*e).kind;
    if kind == NodeKind.INT_LIT {
        return cg_int_text(g, e);
    }
    if kind == NodeKind.FLOAT_LIT {
        return cg_float_text(g, e);
    }
    if kind == NodeKind.CHAR_LIT {
        let t = tx_new(16);
        tx_app_u64(g, t, (*e).num);
        return t;
    }
    if kind == NodeKind.NULL_LIT {
        return cg_new_z("NULL");
    }
    if kind == NodeKind.BOOL_LIT {
        if (*e).flag {
            return cg_new_z("true");
        }
        return cg_new_z("false");
    }
    if kind == NodeKind.STR_LIT {
        return cg_string_literal(g, e);
    }
    if kind == NodeKind.VAR {
        if (*e).resolved_fn != NO_TEXT {
            return cg_function_name(g, (*e).resolved_fn);
        }
        let name = cg_text(g, (*e).name);
        let t = tx_new(name.len + 4);
        tx_app_z(t, "m_");
        tx_app_span(t, name);
        return t;
    }
    if kind == NodeKind.TRY {
        if (*e).num == 0 {
            sup_die("mort: internal error: try expression was not prepared before generation");
        }
        let b = buf_new(32);
        buf_push_z(&b, "mort_try_value_");
        buf_push_u64(&b, (*e).num - 1);
        let t = cg_new_text(g, buf_span(&b));
        free(b.data as *void);
        return t;
    }
    if kind == NodeKind.MOVE {
        let f = (*e).facts as *Facts;
        if f != (0 as *Facts) && !(*f).is_resource_move {
            return cg_gx(g, (*e).a);
        }
        let binding = cg_text(g, (*f).move_binding);
        let t = cg_gx(g, (*e).a);
        let p = cg_scratch_reset(g);
        buf_push_z(p, "((mort_live_m_");
        buf_push_span(p, binding);
        buf_push_z(p, " = false), ");
        cg_pre_scratch(g, t);
        tx_app_z(t, ")");
        return t;
    }
    if kind == NodeKind.STRUCT_LIT {
        return cg_struct_literal(g, e);
    }
    if kind == NodeKind.TUPLE_LIT {
        let t = cg_positional_inits(g, (*e).items);
        cg_wrap_tuple_compound(g, t, (*e).etype);
        return t;
    }
    if kind == NodeKind.FIELD_ACCESS {
        return cg_field_leaf(g, e);
    }
    if kind == NodeKind.ARRAY_LIT {
        return cg_array_literal(g, e);
    }
    if kind == NodeKind.ARRAY_REPEAT {
        return cg_array_repeat(g, e);
    }
    if kind == NodeKind.UNARY {
        return cg_unary(g, e);
    }
    if kind == NodeKind.BINARY {
        if (*e).num != 0 {
            let b = buf_new(32);
            buf_push_z(&b, "mort_short_");
            buf_push_u64(&b, (*e).num - 1);
            let t = cg_new_text(g, buf_span(&b));
            free(b.data as *void);
            return t;
        }
        return cg_c_int_literal(g, cx_big(e), (*e).etype);
    }
    if kind == NodeKind.CALL {
        return cg_call(g, e);
    }
    sup_die("mort: internal error: cannot generate this expression");
    return 0 as *Txt;
}

fn cg_unary(g: *Cg, e: *Node) -> *Txt {
    if (*e).cv != (0 as *void) {
        return cg_c_int_literal(g, cx_big(e), (*e).etype);
    }
    let t = cg_gx(g, (*e).a);
    let op = cg_text(g, (*e).name);
    if span_eq_z(op, "-") || span_eq_z(op, "~") {
        let at = cg_fixed_index(g, (*e).etype);
        if at != CG_FIXED_COUNT {
            cg_fixed_unary(g, at, span_eq_z(op, "-"), t);
            return t;
        }
    }
    let p = cg_scratch_reset(g);
    buf_push(p, '(');
    buf_push_span(p, op);
    cg_pre_scratch(g, t);
    tx_app_z(t, ")");
    return t;
}

// ----- calls -----

fn cg_is_atomic_builtin(n: Span) -> bool {
    return span_eq_z(n, "atomic_i64_create") || span_eq_z(n, "atomic_i64_destroy")
        || span_eq_z(n, "atomic_i64_load") || span_eq_z(n, "atomic_i64_store")
        || span_eq_z(n, "atomic_i64_exchange") || span_eq_z(n, "atomic_i64_fetch_add")
        || span_eq_z(n, "atomic_i64_fetch_sub") || span_eq_z(n, "atomic_i64_compare_exchange");
}

fn cg_is_net_builtin(n: Span) -> bool {
    return span_eq_z(n, "net_tcp_connect") || span_eq_z(n, "net_tcp_listen")
        || span_eq_z(n, "net_tcp_accept") || span_eq_z(n, "net_udp_connect")
        || span_eq_z(n, "net_udp_bind") || span_eq_z(n, "net_udp_send_to")
        || span_eq_z(n, "net_udp_recv_from") || span_eq_z(n, "net_socket_close")
        || span_eq_z(n, "net_socket_send") || span_eq_z(n, "net_socket_recv")
        || span_eq_z(n, "net_socket_shutdown") || span_eq_z(n, "net_socket_local_port")
        || span_eq_z(n, "net_socket_set_nonblocking") || span_eq_z(n, "net_socket_wait")
        || span_eq_z(n, "net_last_error_would_block");
}

fn cg_is_tls_builtin(n: Span) -> bool {
    return span_eq_z(n, "tls_client_connect") || span_eq_z(n, "tls_client_connect_with_ca")
        || span_eq_z(n, "tls_send") || span_eq_z(n, "tls_recv")
        || span_eq_z(n, "tls_protocol_version") || span_eq_z(n, "tls_close");
}

fn cg_is_thread_builtin(n: Span) -> bool {
    return span_eq_z(n, "thread_spawn") || span_eq_z(n, "thread_join")
        || span_eq_z(n, "thread_sleep_millis");
}

fn cg_is_mutex_builtin(n: Span) -> bool {
    return span_eq_z(n, "mutex_create") || span_eq_z(n, "mutex_destroy")
        || span_eq_z(n, "mutex_lock") || span_eq_z(n, "mutex_unlock");
}

fn cg_set_flag(g: *Cg, flag: CgFlag) {
    (*g).flags[flag as u64] = true;
}

fn cg_arg_type(g: *Cg, e: *Node, index: u64) -> Span {
    return cg_text(g, (*ast_item((*e).items, index)).etype);
}

fn cg_first_arg_is_float(g: *Cg, e: *Node) -> bool {
    let t = cg_arg_type(g, e, 0);
    return span_eq_z(t, "f32") || span_eq_z(t, "f64");
}

// The chain of `used_*` assignments at the top of Python's Call branch.
fn cg_note_builtin(g: *Cg, e: *Node, n: Span) {
    if span_eq_z(n, "inb") { cg_set_flag(g, CgFlag.INB); }
    else if span_eq_z(n, "outb") { cg_set_flag(g, CgFlag.OUTB); }
    else if span_eq_z(n, "inw") { cg_set_flag(g, CgFlag.INW); }
    else if span_eq_z(n, "outw") { cg_set_flag(g, CgFlag.OUTW); }
    else if span_eq_z(n, "inl") { cg_set_flag(g, CgFlag.INL); }
    else if span_eq_z(n, "outl") { cg_set_flag(g, CgFlag.OUTL); }
    else if span_eq_z(n, "println") { cg_set_flag(g, CgFlag.PRINTLN); }
    else if span_eq_z(n, "eprintln") { cg_set_flag(g, CgFlag.EPRINTLN); }
    else if span_eq_z(n, "print") && cg_first_arg_is_float(g, e) { cg_set_flag(g, CgFlag.PRINT_FLOAT); }
    else if span_eq_z(n, "print") { cg_set_flag(g, CgFlag.PRINT); }
    else if span_eq_z(n, "assert") { cg_set_flag(g, CgFlag.ASSERT); }
    else if span_eq_z(n, "alloc") { cg_set_flag(g, CgFlag.ALLOC); }
    else if span_eq_z(n, "free") { cg_set_flag(g, CgFlag.FREE); }
    else if span_eq_z(n, "len") && span_eq_z(cg_arg_type(g, e, 0), "*u8") { cg_set_flag(g, CgFlag.LEN); }
    else if span_eq_z(n, "unix_time") || span_eq_z(n, "cpu_millis") { cg_set_flag(g, CgFlag.TIME); }
    else if span_eq_z(n, "file_open") || span_eq_z(n, "file_close") || span_eq_z(n, "file_read")
            || span_eq_z(n, "file_write") || span_eq_z(n, "file_flush") { cg_set_flag(g, CgFlag.FILE); }
    else if span_eq_z(n, "arg_count") || span_eq_z(n, "arg_get") { cg_set_flag(g, CgFlag.ARGS); }
    else if cg_is_thread_builtin(n) { cg_set_flag(g, CgFlag.THREADS); }
    else if cg_is_mutex_builtin(n) { cg_set_flag(g, CgFlag.MUTEXES); }
    else if cg_is_atomic_builtin(n) { cg_set_flag(g, CgFlag.ATOMICS); }
    else if cg_is_net_builtin(n) { cg_set_flag(g, CgFlag.NETWORK); }
    else if span_eq_z(n, "secure_random_fill") { cg_set_flag(g, CgFlag.SECURE_RANDOM); }
    else if cg_is_tls_builtin(n) { cg_set_flag(g, CgFlag.TLS); }
}

fn cg_join_args(g: *Cg, e: *Node) -> *Txt {
    let t = tx_new(64);
    let items = (*e).items;
    for i: u64 in 0..ck_items_len(items) {
        if i != 0 {
            tx_app_z(t, ", ");
        }
        tx_app_txt(t, cg_gx(g, ast_item(items, i)));
    }
    return t;
}

// `name(args)`, reusing the buffer of `args`.
fn cg_finish_call(t: *Txt, name: Span) {
    tx_pre_z(t, "(");
    tx_pre_span(t, name);
    tx_app_z(t, ")");
}

fn cg_named_call(args: *Txt, name: *u8) -> *Txt {
    cg_finish_call(args, span_z(name));
    return args;
}

// A generation of an operand Python makes a second time, its text being thrown away.
fn cg_regenerate(g: *Cg, e: *Node) -> *Txt {
    (*g).regen_depth += 1;
    let t = cg_gx(g, e);
    (*g).regen_depth -= 1;
    return t;
}

fn cg_sizeof_into(g: *Cg, t: *Txt, typ: u64) {
    if ts_is_array((*g).s, typ) {
        let elem: u64 = 0;
        let count: u64 = 0;
        ck_array_parts((*g).c, typ, &elem, &count);
        tx_app_z(t, "(");
        tx_app_span(t, cg_text(g, count));
        tx_app_z(t, "ULL * ");
        cg_sizeof_into(g, t, elem);
        tx_app_z(t, ")");
        return;
    }
    tx_app_z(t, "sizeof(");
    tx_app_span(t, cg_ct_span(g, typ));
    tx_app_z(t, ")");
}

fn cg_enum_constructor(g: *Cg, e: *Node, f: *Facts) -> *Txt {
    let enum_tag = cg_text(g, cg_type_tag(g, (*f).enum_name));
    let variant = cg_text(g, (*f).enum_variant);
    let payload = 0 as *Txt;
    let items = (*e).items;
    if ck_items_len(items) == 1 {
        payload = cg_gx(g, ast_item(items, 0));
    } else {
        payload = cg_positional_inits(g, items);
        cg_wrap_tuple_compound(g, payload, (*f).enum_payload_type);
    }
    let p = cg_scratch_reset(g);
    buf_push_z(p, "(struct mort_");
    buf_push_span(p, enum_tag);
    buf_push_z(p, "){ .tag = MORT_");
    buf_push_span(p, enum_tag);
    buf_push(p, '_');
    buf_push_span(p, variant);
    buf_push_z(p, ", .data.v_");
    buf_push_span(p, variant);
    buf_push_z(p, " = ");
    cg_pre_scratch(g, payload);
    tx_app_z(payload, " }");
    return payload;
}

fn cg_call(g: *Cg, e: *Node) -> *Txt {
    let f = (*e).facts as *Facts;
    if f != (0 as *Facts) && (*f).enum_name != NO_TEXT {
        return cg_enum_constructor(g, e, f);
    }
    let name_text = cg_text(g, (*e).name);
    if f != (0 as *Facts) && (*f).indirect {
        let args = cg_join_args(g, e);
        let p = cg_scratch_reset(g);
        buf_push_z(p, "m_");
        buf_push_span(p, name_text);
        buf_push(p, '(');
        cg_pre_scratch(g, args);
        tx_app_z(args, ")");
        return args;
    }
    cg_note_builtin(g, e, name_text);
    if span_eq_z(name_text, "volatile_read") {
        let c_access = cg_ct_span(g, u64vec_get((*e).names, 0));
        let t = cg_gx(g, ast_item((*e).items, 0));
        let p = cg_scratch_reset(g);
        buf_push_z(p, "(*(const volatile ");
        buf_push_span(p, c_access);
        buf_push_z(p, "*)(");
        cg_pre_scratch(g, t);
        tx_app_z(t, "))");
        return t;
    }
    if span_eq_z(name_text, "volatile_write") {
        let c_access = cg_ct_span(g, u64vec_get((*e).names, 0));
        let t = cg_gx(g, ast_item((*e).items, 0));
        let value = cg_gx(g, ast_item((*e).items, 1));
        let p = cg_scratch_reset(g);
        buf_push_z(p, "((void)(*(volatile ");
        buf_push_span(p, c_access);
        buf_push_z(p, "*)(");
        cg_pre_scratch(g, t);
        tx_app_z(t, ") = (");
        tx_app_txt(t, value);
        tx_app_z(t, ")))");
        return t;
    }
    if span_eq_z(name_text, "slice") {
        return cg_slice_builtin(g, e);
    }
    if span_eq_z(name_text, "len") && ts_is_slice((*g).s, (*ast_item((*e).items, 0)).etype) {
        let first = cg_first_generation(g, ast_item((*e).items, 0));
        let t = cg_second_generation(g, ast_item((*e).items, 0), first);
        tx_pre_z(t, "(");
        tx_app_z(t, ").length");
        return t;
    }
    let args = cg_join_args(g, e);
    return cg_call_named(g, e, f, name_text, args);
}

// One generation of an argument Python generates twice, and whether generating it
// again could change anything.
struct FirstGeneration {
    text: *Txt,
    reusable: bool,
    last: *Node,
}

fn cg_first_generation(g: *Cg, arg: *Node) -> FirstGeneration {
    let strings = (*g).strings.len;
    let repeats = (*g).array_repeat_bytes;
    let spent = (*(*g).c).work_spent;
    let t = cg_gx(g, arg);
    return FirstGeneration {
        text: t,
        reusable: strings == (*g).strings.len && repeats == (*g).array_repeat_bytes
            && spent == (*(*g).c).work_spent,
        last: (*(*g).c).current_node,
    };
}

// A generation with no effects gave the same text the second one would.
fn cg_second_generation(g: *Cg, arg: *Node, first: FirstGeneration) -> *Txt {
    if first.reusable {
        (*(*g).c).current_node = first.last;
        return first.text;
    }
    tx_free(first.text);
    return cg_regenerate(g, arg);
}

// `slice<T>(p, n)`: Python's join generates both arguments, then the compound
// literal generates them again, with the type name first.
fn cg_slice_builtin(g: *Cg, e: *Node) -> *Txt {
    let items = (*e).items;
    let first_data = cg_first_generation(g, ast_item(items, 0));
    let first_len = cg_first_generation(g, ast_item(items, 1));
    let name = buf_new(64);
    buf_push(&name, '(');
    cg_slice_c_name(g, &name, (*e).etype);
    buf_push_z(&name, "){ .data = ");
    let t = cg_second_generation(g, ast_item(items, 0), first_data);
    let count = cg_second_generation(g, ast_item(items, 1), first_len);
    tx_pre_span(t, buf_span(&name));
    free(name.data as *void);
    tx_app_z(t, ", .length = ");
    tx_app_txt(t, count);
    tx_app_z(t, " }");
    return t;
}

fn cg_call_named(g: *Cg, e: *Node, f: *Facts, n: Span, args: *Txt) -> *Txt {
    if span_eq_z(n, "sizeof") {
        tx_free(args);
        let t = tx_new(32);
        tx_app_z(t, "((uint64_t)");
        cg_sizeof_into(g, t, u64vec_get((*e).names, 0));
        tx_app_z(t, ")");
        return t;
    }
    if span_eq_z(n, "print") {
        if cg_first_arg_is_float(g, e) {
            return cg_destroyed(g, f, cg_named_call(args, "mort_print_float"));
        }
        return cg_destroyed(g, f, cg_named_call(args, "mort_print"));
    }
    if span_eq_z(n, "println") {
        return cg_destroyed(g, f, cg_named_call(args, "mort_println"));
    }
    if span_eq_z(n, "eprintln") {
        return cg_destroyed(g, f, cg_named_call(args, "mort_eprintln"));
    }
    if span_eq_z(n, "assert") || span_eq_z(n, "arg_get") {
        let name = "mort_assert";
        if span_eq_z(n, "arg_get") {
            name = "mort_arg_get";
        }
        tx_pre_z(args, "(");
        tx_pre_z(args, name);
        tx_app_z(args, ", ");
        tx_app_u64(g, args, (*e).line);
        tx_app_z(args, ")");
        return args;
    }
    if span_eq_z(n, "arg_count") {
        return cg_destroyed(g, f, cg_named_call(args, "mort_arg_count"));
    }
    if span_eq_z(n, "alloc") {
        return cg_destroyed(g, f, cg_named_call(args, "mort_alloc"));
    }
    if span_eq_z(n, "free") {
        return cg_destroyed(g, f, cg_named_call(args, "mort_free"));
    }
    if span_eq_z(n, "len") {
        let arg_type = (*ast_item((*e).items, 0)).etype;
        if ts_is_array((*g).s, arg_type) {
            tx_free(args);
            let elem: u64 = 0;
            let count: u64 = 0;
            ck_array_parts((*g).c, arg_type, &elem, &count);
            return cg_new_text(g, cg_text(g, count));
        }
        return cg_destroyed(g, f, cg_named_call(args, "mort_len"));
    }
    if cg_is_thread_builtin(n) || cg_is_mutex_builtin(n) || cg_is_atomic_builtin(n)
            || cg_is_net_builtin(n) || span_eq_z(n, "secure_random_fill") || cg_is_tls_builtin(n) {
        let p = cg_scratch_reset(g);
        buf_push_z(p, "mort_");
        buf_push_span(p, n);
        buf_push(p, '(');
        cg_pre_scratch(g, args);
        tx_app_z(args, ")");
        return cg_destroyed(g, f, args);
    }
    let resolved = (*e).name;
    if f != (0 as *Facts) && (*f).resolved_name != NO_TEXT {
        resolved = (*f).resolved_name;
    }
    if map_has(&(*g).extern_names, resolved) {
        cg_finish_call(args, cg_text(g, resolved));
    } else {
        let p = cg_scratch_reset(g);
        buf_push_z(p, "mort_");
        cg_sym(g, p, resolved);
        buf_push(p, '(');
        cg_pre_scratch(g, args);
        tx_app_z(args, ")");
    }
    return cg_destroyed(g, f, args);
}

// The destroy call's `(call, mort_live_m_x = false)`.
fn cg_destroyed(g: *Cg, f: *Facts, call: *Txt) -> *Txt {
    if f == (0 as *Facts) || (*f).destroys_binding == NO_TEXT || (*f).deferred_destroy {
        return call;
    }
    tx_pre_z(call, "(");
    tx_app_z(call, ", mort_live_m_");
    tx_app_span(call, cg_text(g, (*f).destroys_binding));
    tx_app_z(call, " = false)");
    return call;
}

// ----- the entry points -----

// `_gen_expr`. The text lives until the next statement.
fn cg_expr(g: *Cg, e: *Node) -> Span {
    let t = cg_gx(g, e);
    ptrvec_push(&(*g).live_text, t as *void);
    return tx_span(t);
}

fn cg_release_text(g: *Cg) {
    for i: u64 in 0..(*g).live_text.len {
        tx_free(ptrvec_get(&(*g).live_text, i) as *Txt);
    }
    (*g).live_text.len = 0;
}

// ----- writing the output -----

struct CgWriter {
    handle: *void,
    pending: Buf,
    failed: bool,
}

fn cw_write(w: *CgWriter, data: *u8, len: u64) {
    if len != 0 && file_write((*w).handle, data, len) != len {
        (*w).failed = true;
    }
}

fn cw_flush(w: *CgWriter) {
    cw_write(w, (*w).pending.data, (*w).pending.len);
    (*w).pending.len = 0;
}

fn cw_span(w: *CgWriter, s: Span) {
    if s.len >= CG_WRITE_CHUNK {
        cw_flush(w);
        cw_write(w, s.data, s.len);
        return;
    }
    buf_push_span(&(*w).pending, s);
    if (*w).pending.len >= CG_WRITE_CHUNK {
        cw_flush(w);
    }
}

fn cw_text(w: *CgWriter, g: *Cg, text: Span) {
    let start: u64 = 0;
    let i: u64 = 0;
    while i < text.len {
        if text.data[i] != CG_TOKEN_BYTE {
            i += 1;
            continue;
        }
        cw_span(w, ts_sub(text, start, i));
        let index: u64 = 0;
        i = cg_token_at(text, i, &index);
        start = i;
        cw_repeat(w, g, ptrvec_get(&(*g).big_repeats, index) as *BigRepeat);
    }
    cw_span(w, ts_sub(text, start, text.len));
}

// The string table, one line per entry, in `mort_str_N` order.
fn cw_strings(w: *CgWriter, g: *Cg) {
    for i: u64 in 0..(*g).strings.len {
        if i != 0 {
            buf_push(&(*w).pending, 10);
        }
        buf_push_z(&(*w).pending, "static uint8_t mort_str_");
        buf_push_u64(&(*w).pending, i);
        buf_push_z(&(*w).pending, "[] = \"");
        buf_push_span(&(*w).pending, *(ptrvec_get(&(*g).strings, i) as *Span));
        buf_push_z(&(*w).pending, "\";");
        if (*w).pending.len >= CG_WRITE_CHUNK {
            cw_flush(w);
        }
    }
}

fn cw_repeat(w: *CgWriter, g: *Cg, big: *BigRepeat) {
    if (*big).kind == CG_BIG_STRINGS {
        cw_strings(w, g);
        return;
    }
    if (*big).kind == CG_BIG_SHARED {
        cw_text(w, g, (*big).value);
        return;
    }
    cw_span(w, span_z("{"));
    for i: u64 in 0..(*big).count {
        if i != 0 {
            cw_span(w, span_z(", "));
        }
        cw_text(w, g, (*big).value);
    }
    cw_span(w, span_z("}"));
}

// Writes the finished program; false on a short write. A big array repeat expands
// here, in place of its token.
fn cg_write_output(g: *Cg, handle: *void, output: *Buf) -> bool {
    let w = CgWriter { handle: handle, pending: buf_new(CG_WRITE_CHUNK), failed: false };
    cw_text(&w, g, buf_span(output));
    cw_flush(&w);
    free(w.pending.data as *void);
    return !w.failed;
}
