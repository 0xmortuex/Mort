// Mort standard library: slice helpers over []const u8 text.

module std.strings;

import std.bytes;
import std.option;
import std.owned_string;
import std.vec;

pub fn equal(left: []const u8, right: []const u8) -> bool {
    return bytes.equal(left, right);
}

pub fn starts_with(text: []const u8, prefix: []const u8) -> bool {
    if prefix.len > text.len {
        return false;
    }
    return bytes.equal(slice(text.data, prefix.len), prefix);
}

pub fn ends_with(text: []const u8, suffix: []const u8) -> bool {
    if suffix.len > text.len {
        return false;
    }
    let offset: u64 = text.len - suffix.len;
    return bytes.equal(slice(((text.data as u64) + offset) as *const u8, suffix.len), suffix);
}

// First byte offset of `needle` in `text`, or None if it does not occur.
// An empty needle matches at offset 0.
pub fn index_of(text: []const u8, needle: []const u8) -> Option<u64> {
    if needle.len == 0 {
        return Option<u64>.Some(0);
    }
    if needle.len > text.len {
        return Option<u64>.None;
    }
    let last: u64 = text.len - needle.len;
    for start: u64 in 0..(last + 1) {
        if bytes.equal(slice(((text.data as u64) + start) as *const u8, needle.len), needle) {
            return Option<u64>.Some(start);
        }
    }
    return Option<u64>.None;
}

// Last byte offset of `needle` in `text`, or None if it does not occur.
// The reverse counterpart to `index_of`: scans from the end, so overlapping
// candidate positions prefer the rightmost one. An empty needle matches at
// the last possible start position, `text.len` (matching `index_of`'s
// empty-needle convention of matching at the first possible position, 0).
pub fn last_index_of(text: []const u8, needle: []const u8) -> Option<u64> {
    if needle.len == 0 {
        return Option<u64>.Some(text.len);
    }
    if needle.len > text.len {
        return Option<u64>.None;
    }
    let last: u64 = text.len - needle.len;
    let start: u64 = last + 1;
    while start > 0 {
        start -= 1;
        if bytes.equal(slice(((text.data as u64) + start) as *const u8, needle.len), needle) {
            return Option<u64>.Some(start);
        }
    }
    return Option<u64>.None;
}

// Whether `needle` occurs anywhere in `text`. A thin convenience wrapper
// over `index_of(text, needle).is_some()`.
pub fn contains(text: []const u8, needle: []const u8) -> bool {
    match index_of(text, needle) {
        Option<u64>.Some(offset) => { return true; },
        Option<u64>.None => { return false; },
    }
}

fn is_ascii_space(byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12;
}

// Trims leading and trailing ASCII whitespace, returning a view into `text`.
pub fn trim(text: []const u8) -> []const u8 {
    let start: u64 = 0;
    while start < text.len && is_ascii_space(text[start]) {
        start += 1;
    }
    let end: u64 = text.len;
    while end > start && is_ascii_space(text[end - 1]) {
        end -= 1;
    }
    return slice(((text.data as u64) + start) as *const u8, end - start);
}

// Trims only leading ASCII whitespace, returning a view into `text`.
pub fn trim_start(text: []const u8) -> []const u8 {
    let start: u64 = 0;
    while start < text.len && is_ascii_space(text[start]) {
        start += 1;
    }
    return slice(((text.data as u64) + start) as *const u8, text.len - start);
}

// Trims only trailing ASCII whitespace, returning a view into `text`.
pub fn trim_end(text: []const u8) -> []const u8 {
    let end: u64 = text.len;
    while end > 0 && is_ascii_space(text[end - 1]) {
        end -= 1;
    }
    return slice(text.data, end);
}

// Parses an unsigned decimal integer. None on an empty or non-digit input.
pub fn parse_u64(text: []const u8) -> Option<u64> {
    if text.len == 0 {
        return Option<u64>.None;
    }
    let value: u64 = 0;
    for index: u64 in 0..text.len {
        let byte = text[index];
        if byte < 48 || byte > 57 {
            return Option<u64>.None;
        }
        value = value * 10 + ((byte - 48) as u64);
    }
    return Option<u64>.Some(value);
}

// Parses a signed decimal integer with an optional leading '-'. None on an
// empty, sign-only, or non-digit input.
pub fn parse_i64(text: []const u8) -> Option<i64> {
    if text.len == 0 {
        return Option<i64>.None;
    }
    let negative: bool = false;
    let start: u64 = 0;
    if text[0] == 45 {
        negative = true;
        start = 1;
    }
    if start >= text.len {
        return Option<i64>.None;
    }
    let value: i64 = 0;
    for index: u64 in start..text.len {
        let byte = text[index];
        if byte < 48 || byte > 57 {
            return Option<i64>.None;
        }
        value = value * 10 + ((byte - 48) as i64);
    }
    if negative {
        value = 0 - value;
    }
    return Option<i64>.Some(value);
}

// Number of decimal digits `value` prints as (at least 1, since 0 prints as
// a single "0" digit). A private helper shared by `from_u64`/`from_i64`.
fn count_digits(value: u64) -> u64 {
    if value == 0 {
        return 1;
    }
    let count: u64 = 0;
    let remaining: u64 = value;
    while remaining > 0 {
        count += 1;
        remaining = remaining / 10;
    }
    return count;
}

// Writes `value`'s `count` decimal digits (as produced by `count_digits`)
// into `destination` starting at `offset`, most significant digit first, no
// sign. A private helper shared by `from_u64`/`from_i64`.
fn write_digits(value: u64, destination: []u8, offset: u64, count: u64) -> void {
    if value == 0 {
        destination[offset] = 48;
        return;
    }
    let remaining: u64 = value;
    let index: u64 = count;
    while remaining > 0 {
        index -= 1;
        destination[offset + index] = ((48 + (remaining % 10)) as u8);
        remaining = remaining / 10;
    }
}

// Returns a new owned buffer holding the decimal digits of `value`, the
// inverse of `parse_u64` (`parse_u64(view(from_u64(value)))` round-trips
// back to `Some(value)`). `value == 0` returns `"0"`. The result is a
// freshly allocated buffer; the caller must call `std.owned_string.destroy`
// on it.
pub fn from_u64(value: u64) -> String {
    let count: u64 = count_digits(value);
    let data: *u8 = alloc(count + 1) as *u8;
    let destination: []u8 = slice(data, count + 1);
    write_digits(value, destination, 0, count);
    destination[count] = 0;
    return String { data: data, length: count };
}

// Returns a new owned buffer holding the decimal digits of `value`, with a
// leading '-' for negative values, the inverse of `parse_i64`. The
// magnitude of `value` is computed via two's-complement negation in `u64`
// space (`~(value as u64) + 1`) rather than signed negation, so this is
// correct even for `value == i64::MIN`, whose magnitude (2^63) has no
// positive `i64` representation to negate into. The result is a freshly
// allocated buffer; the caller must call `std.owned_string.destroy` on it.
pub fn from_i64(value: i64) -> String {
    if value >= 0 {
        return from_u64(value as u64);
    }
    let magnitude: u64 = (~(value as u64)) + 1;
    let count: u64 = count_digits(magnitude);
    let total: u64 = count + 1;
    let data: *u8 = alloc(total + 1) as *u8;
    let destination: []u8 = slice(data, total + 1);
    destination[0] = 45;
    write_digits(magnitude, destination, 1, count);
    destination[total] = 0;
    return String { data: data, length: total };
}

// Number of hex digits `value` prints as (at least 1, since 0 prints as a
// single "0" digit). A private helper for `to_hex`.
fn count_hex_digits(value: u64) -> u64 {
    if value == 0 {
        return 1;
    }
    let count: u64 = 0;
    let remaining: u64 = value;
    while remaining > 0 {
        count += 1;
        remaining = remaining / 16;
    }
    return count;
}

// Writes `value`'s `count` hex digits (as produced by `count_hex_digits`)
// into `destination` starting at `offset`, most significant nibble first,
// lowercase `a`-`f` for digits 10-15. A private helper for `to_hex`.
fn write_hex_digits(value: u64, destination: []u8, offset: u64, count: u64) -> void {
    if value == 0 {
        destination[offset] = 48;
        return;
    }
    let remaining: u64 = value;
    let index: u64 = count;
    while remaining > 0 {
        index -= 1;
        let nibble: u64 = remaining % 16;
        if nibble < 10 {
            destination[offset + index] = (48 + nibble) as u8;
        } else {
            destination[offset + index] = (87 + nibble) as u8;
        }
        remaining = remaining / 16;
    }
}

// Returns a new owned buffer holding `value` formatted as lowercase
// hexadecimal digits, no "0x" prefix and no leading zeros (`value == 0`
// returns `"0"`). The result is a freshly allocated buffer; the caller must
// call `std.owned_string.destroy` on it.
pub fn to_hex(value: u64) -> String {
    let count: u64 = count_hex_digits(value);
    let data: *u8 = alloc(count + 1) as *u8;
    let destination: []u8 = slice(data, count + 1);
    write_hex_digits(value, destination, 0, count);
    destination[count] = 0;
    return String { data: data, length: count };
}

// Parses an unsigned hexadecimal integer (no "0x" prefix), the inverse of
// `to_hex` (`parse_hex(view(to_hex(value)))` round-trips back to
// `Some(value)`). Accepts both lowercase and uppercase `a`-`f`/`A`-`F`
// digits. None on an empty or non-hex-digit input. Like `parse_u64`, more
// than 16 digits silently overflows rather than being rejected.
pub fn parse_hex(text: []const u8) -> Option<u64> {
    if text.len == 0 {
        return Option<u64>.None;
    }
    let value: u64 = 0;
    for index: u64 in 0..text.len {
        let byte = text[index];
        let digit: u64 = 0;
        if byte >= '0' && byte <= '9' {
            digit = (byte - '0') as u64;
        } else if byte >= 'a' && byte <= 'f' {
            digit = (byte - 'a') as u64 + 10;
        } else if byte >= 'A' && byte <= 'F' {
            digit = (byte - 'A') as u64 + 10;
        } else {
            return Option<u64>.None;
        }
        value = value * 16 + digit;
    }
    return Option<u64>.Some(value);
}

// Splits `text` on every occurrence of `separator`, returning a Vec of views
// borrowed from `text` (no copies, no allocation beyond the Vec itself).
// Matches Python's `str.split(sep)`: consecutive separators produce empty
// elements, and a leading/trailing separator produces a leading/trailing
// empty element. An empty `separator` returns a single-element Vec holding
// all of `text` unchanged, rather than splitting between every byte.
pub fn split(text: []const u8, separator: []const u8) -> Vec<[]const u8> {
    let parts: Vec<[]const u8> = vec.new<[]const u8>();
    if separator.len == 0 {
        vec.push(&parts, text);
        return move parts;
    }
    let start: u64 = 0;
    let index: u64 = 0;
    while index + separator.len <= text.len {
        if bytes.equal(slice(((text.data as u64) + index) as *const u8, separator.len), separator) {
            vec.push(&parts, slice(((text.data as u64) + start) as *const u8, index - start));
            index = index + separator.len;
            start = index;
        } else {
            index = index + 1;
        }
    }
    vec.push(&parts, slice(((text.data as u64) + start) as *const u8, text.len - start));
    return move parts;
}

// Concatenates every element of `parts` (as produced by `split`) with
// `separator` inserted between consecutive elements, matching Python's
// `separator.join(parts)`: zero elements yields an empty string, and one
// element yields an unchanged copy of it with no separator inserted. The
// result is a freshly allocated owned buffer; the caller must call
// `std.owned_string.destroy` on it.
pub fn join(parts: *Vec<[]const u8>, separator: []const u8) -> String {
    let count: u64 = (*parts).length;
    let total: u64 = 0;
    if count > 0 {
        total = separator.len * (count - 1);
    }
    for index: u64 in 0..count {
        match vec.get(parts, index) {
            Option<[]const u8>.Some(part) => { total += part.len; },
            Option<[]const u8>.None => {},
        }
    }
    let data: *u8 = alloc(total + 1) as *u8;
    let destination: []u8 = slice(data, total + 1);
    let write: u64 = 0;
    for index: u64 in 0..count {
        if index > 0 {
            for offset: u64 in 0..separator.len {
                destination[write + offset] = separator[offset];
            }
            write += separator.len;
        }
        match vec.get(parts, index) {
            Option<[]const u8>.Some(part) => {
                for offset: u64 in 0..part.len {
                    destination[write + offset] = part[offset];
                }
                write += part.len;
            },
            Option<[]const u8>.None => {},
        }
    }
    destination[total] = 0;
    return String { data: data, length: total };
}

fn copy_view(text: []const u8) -> String {
    let data: *u8 = alloc(text.len + 1) as *u8;
    let destination: []u8 = slice(data, text.len + 1);
    bytes.copy(destination, text);
    destination[text.len] = 0;
    return String { data: data, length: text.len };
}

// Returns a new owned buffer with every non-overlapping, left-to-right
// occurrence of `old` in `text` replaced by `new` (replace-all, matching
// Python's `str.replace(old, new)` with no `count` argument -- occurrences
// are found by scanning left to right and are not rescanned once matched, so
// overlapping matches only replace the first). An empty `old` returns an
// unchanged owned copy of `text`, consistent with `split`'s treatment of an
// empty separator, rather than Python's insert-between-every-byte behavior
// for an empty search string. The result is a freshly allocated buffer since
// its length generally differs from `text`'s; the caller owns it and must
// call `std.owned_string.destroy` on it.
pub fn replace(text: []const u8, old: []const u8, new: []const u8) -> String {
    if old.len == 0 {
        return copy_view(text);
    }
    let match_count: u64 = 0;
    let scan: u64 = 0;
    while scan + old.len <= text.len {
        if bytes.equal(slice(((text.data as u64) + scan) as *const u8, old.len), old) {
            match_count += 1;
            scan += old.len;
        } else {
            scan += 1;
        }
    }
    if match_count == 0 {
        return copy_view(text);
    }
    let result_length: u64 = text.len - match_count * old.len + match_count * new.len;
    let data: *u8 = alloc(result_length + 1) as *u8;
    let destination: []u8 = slice(data, result_length + 1);
    let write: u64 = 0;
    let read: u64 = 0;
    while read + old.len <= text.len {
        if bytes.equal(slice(((text.data as u64) + read) as *const u8, old.len), old) {
            for offset: u64 in 0..new.len {
                destination[write + offset] = new[offset];
            }
            write += new.len;
            read += old.len;
        } else {
            destination[write] = text[read];
            write += 1;
            read += 1;
        }
    }
    while read < text.len {
        destination[write] = text[read];
        write += 1;
        read += 1;
    }
    destination[result_length] = 0;
    return String { data: data, length: result_length };
}

// Counts non-overlapping, left-to-right occurrences of `needle` in `text`,
// using the same matching pass as `replace`'s first (counting) loop -- a
// match consumes its bytes and is not rescanned, so overlapping candidates
// only count once (e.g. `count("aaaa", "aa")` is 2, not 3). An empty
// `needle` returns 0, consistent with `replace`'s and `split`'s treatment of
// an empty search string as a no-op, rather than Python's `str.count("")`,
// which returns `text.len + 1`.
pub fn count(text: []const u8, needle: []const u8) -> u64 {
    if needle.len == 0 {
        return 0;
    }
    let match_count: u64 = 0;
    let scan: u64 = 0;
    while scan + needle.len <= text.len {
        if bytes.equal(slice(((text.data as u64) + scan) as *const u8, needle.len), needle) {
            match_count += 1;
            scan += needle.len;
        } else {
            scan += 1;
        }
    }
    return match_count;
}

// Returns a new owned buffer containing `text` repeated `count` times,
// matching Python's `text * count`. `count == 0` returns an empty owned
// string (consistent with `join`'s zero-element case). The result is a
// freshly allocated buffer; the caller must call `std.owned_string.destroy`
// on it.
pub fn repeat(text: []const u8, count: u64) -> String {
    let result_length: u64 = text.len * count;
    let data: *u8 = alloc(result_length + 1) as *u8;
    let destination: []u8 = slice(data, result_length + 1);
    let write: u64 = 0;
    for iteration: u64 in 0..count {
        for offset: u64 in 0..text.len {
            destination[write + offset] = text[offset];
        }
        write += text.len;
    }
    destination[result_length] = 0;
    return String { data: data, length: result_length };
}

// The two views produced by `split_once`: the text before and after the
// first `separator` match. Both are borrowed views into the original text.
struct SplitOnce {
    before: []const u8,
    after: []const u8,
}

// Splits `text` into the views before and after the first occurrence of
// `separator`, or `None` if `separator` does not occur. Unlike `split`
// (which allocates a `Vec` of every piece), this borrows just the two views
// a caller needs to pull e.g. `key`/`value` out of `"key=value"`-shaped
// text without paying for a full split. An empty `separator` matches at
// offset 0, matching `index_of`'s empty-needle convention: `before` is
// empty and `after` is all of `text`.
pub fn split_once(text: []const u8, separator: []const u8) -> Option<SplitOnce> {
    match index_of(text, separator) {
        Option<u64>.Some(offset) => {
            let after_start: u64 = offset + separator.len;
            return Option<SplitOnce>.Some(SplitOnce {
                before: slice(text.data, offset),
                after: slice(((text.data as u64) + after_start) as *const u8, text.len - after_start),
            });
        },
        Option<u64>.None => { return Option<SplitOnce>.None; },
    }
}

// Splits `text` into the views before and after the *last* occurrence of
// `separator`, or `None` if `separator` does not occur. The reverse
// counterpart to `split_once`, built the same way `last_index_of` mirrors
// `index_of` — useful for e.g. peeling a file extension or the last path
// segment off `text`. Reuses `SplitOnce`; both views are borrowed from
// `text`, no allocation. An empty `separator` matches at the last possible
// position, `text.len` (matching `last_index_of`'s empty-needle
// convention): `before` is all of `text` and `after` is empty.
pub fn rsplit_once(text: []const u8, separator: []const u8) -> Option<SplitOnce> {
    match last_index_of(text, separator) {
        Option<u64>.Some(offset) => {
            let after_start: u64 = offset + separator.len;
            return Option<SplitOnce>.Some(SplitOnce {
                before: slice(text.data, offset),
                after: slice(((text.data as u64) + after_start) as *const u8, text.len - after_start),
            });
        },
        Option<u64>.None => { return Option<SplitOnce>.None; },
    }
}
