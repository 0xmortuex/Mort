module std.math_float;

// Kept separate from std.math (which is entirely integer-generic): Mort
// does not eliminate unused functions from an imported module, so adding
// these extern-libm-backed wrappers to std.math would force every existing
// std.math importer to start linking against libm, whether they use floats
// or not. Programs that import std.math_float must link against the system
// math library themselves, e.g. `mortc.py program.mx -l m`.

extern fn sqrt(value: f64) -> f64;
extern fn floor(value: f64) -> f64;
extern fn ceil(value: f64) -> f64;
extern fn round(value: f64) -> f64;
extern fn trunc(value: f64) -> f64;

pub fn sqrt_f64(value: f64) -> f64 {
    return sqrt(value);
}

pub fn floor_f64(value: f64) -> f64 {
    return floor(value);
}

pub fn ceil_f64(value: f64) -> f64 {
    return ceil(value);
}

pub fn round_f64(value: f64) -> f64 {
    return round(value);
}

pub fn trunc_f64(value: f64) -> f64 {
    return trunc(value);
}
