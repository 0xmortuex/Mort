module std.result;

import std.option;

enum Result<Value, Error> {
    Ok(Value),
    Err(Error),
}

// Consumes `value`; for a resource `Value`/`Error` the payload is dropped by
// this call (there is no by-reference variant, since Mort enums expose no
// tag-only inspection without a match). Mirrors std.option.is_some.
pub fn is_ok<Value, Error>(value: Result<Value, Error>) -> bool {
    match move value {
        Result<Value, Error>.Ok(payload) => { return true; }
        Result<Value, Error>.Err(payload) => { return false; }
    }
}

// Consumes `value`; see `is_ok`'s resource-drop note.
pub fn is_err<Value, Error>(value: Result<Value, Error>) -> bool {
    match move value {
        Result<Value, Error>.Ok(payload) => { return false; }
        Result<Value, Error>.Err(payload) => { return true; }
    }
}

// Consumes both `value` and `default`; returns the `Ok` payload, or
// `default` if `value` is `Err`. For a resource `Value`/`Error`, whichever
// of the two is not returned is dropped automatically.
pub fn unwrap_or<Value, Error>(value: Result<Value, Error>, default: Value) -> Value {
    match move value {
        Result<Value, Error>.Ok(payload) => { return move payload; }
        Result<Value, Error>.Err(payload) => { return move default; }
    }
}

// Consumes `value`; returns the `Ok` payload, or the result of calling
// `f(error)` if `value` is `Err`. The lazy counterpart to `unwrap_or`: `f`
// is only called when `value` is `Err`, and (unlike `std.option`'s
// `unwrap_or_else`) it receives the `Err` payload, so a caller can turn the
// error into a fallback `Value` instead of supplying a fixed default. `f`
// is a plain top-level function reference (Mort has no closures). See
// `is_ok`'s resource-drop note for `value`'s consuming semantics.
pub fn unwrap_or_else<Value, Error>(value: Result<Value, Error>, f: fn(Error) -> Value) -> Value {
    match move value {
        Result<Value, Error>.Ok(payload) => { return move payload; }
        Result<Value, Error>.Err(payload) => { return f(move payload); }
    }
}

// Consumes `value`; applies `f` to an `Ok` payload and wraps the result as
// `Result<Mapped, Error>.Ok(...)`, or returns `Result<Mapped, Error>.Err`
// unchanged (with the original error payload, never calling `f`) if `value`
// is `Err`. `f` is a plain top-level function reference (Mort has no
// closures), matching `std.option.map`'s convention. See `is_ok`'s
// resource-drop note for `value`'s consuming semantics.
pub fn map<Value, Error, Mapped>(value: Result<Value, Error>, f: fn(Value) -> Mapped) -> Result<Mapped, Error> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Result<Mapped, Error>.Ok(f(move payload)); }
        Result<Value, Error>.Err(payload) => { return Result<Mapped, Error>.Err(move payload); }
    }
}

// Consumes `value`; the error-side counterpart to `map`. Applies `f` to an
// `Err` payload and wraps the result as `Result<Value, MappedError>.Err(...)`,
// or returns `Result<Value, MappedError>.Ok` unchanged (with the original
// Ok payload, never calling `f`) if `value` is `Ok`. Same plain-top-level-
// function-reference and resource-drop conventions as `map`.
pub fn map_err<Value, Error, MappedError>(value: Result<Value, Error>, f: fn(Error) -> MappedError) -> Result<Value, MappedError> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Result<Value, MappedError>.Ok(move payload); }
        Result<Value, Error>.Err(payload) => { return Result<Value, MappedError>.Err(f(move payload)); }
    }
}

// Consumes `value`; converts to `std.option.Option`, the natural counterpart
// to `std.option.ok_or`. An `Ok` payload becomes `Some`; an `Err` payload is
// discarded (dropped automatically for a resource `Error`) and the result is
// `None`.
pub fn ok<Value, Error>(value: Result<Value, Error>) -> Option<Value> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Option<Value>.Some(move payload); }
        Result<Value, Error>.Err(payload) => { return Option<Value>.None; }
    }
}
