module std.result;

import std.option;

enum Result<Value, Error> {
    Ok(Value),
    Err(Error),
}

// Consumes `value`; for a resource `Value`/`Error` the payload is dropped by
// this call (there is no by-reference variant, since Mort enums expose no
// tag-only inspection without a match). Mirrors std.option.is_some.
pub fn is_ok<Value, Error>(value: Result<Value, Error>) -> bool {
    match move value {
        Result<Value, Error>.Ok(payload) => { return true; }
        Result<Value, Error>.Err(payload) => { return false; }
    }
}

// Consumes `value`; see `is_ok`'s resource-drop note.
pub fn is_err<Value, Error>(value: Result<Value, Error>) -> bool {
    match move value {
        Result<Value, Error>.Ok(payload) => { return false; }
        Result<Value, Error>.Err(payload) => { return true; }
    }
}

// Consumes both `value` and `default`; returns the `Ok` payload, or
// `default` if `value` is `Err`. For a resource `Value`/`Error`, whichever
// of the two is not returned is dropped automatically.
pub fn unwrap_or<Value, Error>(value: Result<Value, Error>, default: Value) -> Value {
    match move value {
        Result<Value, Error>.Ok(payload) => { return move payload; }
        Result<Value, Error>.Err(payload) => { return move default; }
    }
}

// Consumes `value`; returns the `Ok` payload, or the result of calling
// `f(error)` if `value` is `Err`. The lazy counterpart to `unwrap_or`: `f`
// is only called when `value` is `Err`, and (unlike `std.option`'s
// `unwrap_or_else`) it receives the `Err` payload, so a caller can turn the
// error into a fallback `Value` instead of supplying a fixed default. `f`
// is a plain top-level function reference (Mort has no closures). See
// `is_ok`'s resource-drop note for `value`'s consuming semantics.
pub fn unwrap_or_else<Value, Error>(value: Result<Value, Error>, f: fn(Error) -> Value) -> Value {
    match move value {
        Result<Value, Error>.Ok(payload) => { return move payload; }
        Result<Value, Error>.Err(payload) => { return f(move payload); }
    }
}

// Consumes `value`; applies `f` to an `Ok` payload and wraps the result as
// `Result<Mapped, Error>.Ok(...)`, or returns `Result<Mapped, Error>.Err`
// unchanged (with the original error payload, never calling `f`) if `value`
// is `Err`. `f` is a plain top-level function reference (Mort has no
// closures), matching `std.option.map`'s convention. See `is_ok`'s
// resource-drop note for `value`'s consuming semantics.
pub fn map<Value, Error, Mapped>(value: Result<Value, Error>, f: fn(Value) -> Mapped) -> Result<Mapped, Error> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Result<Mapped, Error>.Ok(f(move payload)); }
        Result<Value, Error>.Err(payload) => { return Result<Mapped, Error>.Err(move payload); }
    }
}

// Consumes `value`; the error-side counterpart to `map`. Applies `f` to an
// `Err` payload and wraps the result as `Result<Value, MappedError>.Err(...)`,
// or returns `Result<Value, MappedError>.Ok` unchanged (with the original
// Ok payload, never calling `f`) if `value` is `Ok`. Same plain-top-level-
// function-reference and resource-drop conventions as `map`.
pub fn map_err<Value, Error, MappedError>(value: Result<Value, Error>, f: fn(Error) -> MappedError) -> Result<Value, MappedError> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Result<Value, MappedError>.Ok(move payload); }
        Result<Value, Error>.Err(payload) => { return Result<Value, MappedError>.Err(f(move payload)); }
    }
}

// Consumes `value`; applies `f` to an `Ok` payload and returns its result
// directly (no extra `Ok`-wrapping, unlike `map`), or returns
// `Result<Mapped, Error>.Err` unchanged (with the original error payload,
// never calling `f`) if `value` is `Err`. The "flat-map" counterpart to
// `map`, for chaining a function that already returns a `Result` itself
// (e.g. a second fallible step), matching `std.option.and_then`'s
// convention. `f` is a plain top-level function reference (Mort has no
// closures). See `is_ok`'s resource-drop note for `value`'s consuming
// semantics.
pub fn and_then<Value, Error, Mapped>(value: Result<Value, Error>, f: fn(Value) -> Result<Mapped, Error>) -> Result<Mapped, Error> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return f(move payload); }
        Result<Value, Error>.Err(payload) => { return Result<Mapped, Error>.Err(move payload); }
    }
}

// Consumes both `value` and `other`; returns `other` unchanged if `value`
// is `Ok` (the `Ok` payload itself is discarded — automatically dropped for
// a resource `Value` — only `value`'s tag matters), or returns
// `Result<Mapped, Error>.Err` with the original error payload (never
// touching `other`, which is dropped unused for a resource `Mapped`) if
// `value` is `Err`. The eager counterpart to `and_then`, matching
// `std.option.and`'s relationship to `and_then`: `and_then` calls
// `f(payload)` to produce the next `Result`; `and` instead takes the next
// `Result` directly, for the common case where it doesn't depend on
// `value`'s payload at all.
pub fn and<Value, Error, Mapped>(value: Result<Value, Error>, other: Result<Mapped, Error>) -> Result<Mapped, Error> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return move other; }
        Result<Value, Error>.Err(payload) => { return Result<Mapped, Error>.Err(move payload); }
    }
}

// Consumes `value`; the error-side counterpart to `and_then`. Returns `value`
// unchanged (re-wrapped as `Result<Value, MappedError>.Ok`, never calling
// `f`) if `value` is `Ok`, or applies `f` to an `Err` payload and returns its
// result directly (no extra `Err`-wrapping) if `value` is `Err` — the
// `Result` counterpart to `std.option.and_then`/`unwrap_or_else`: lets a
// caller recover from an error into a fresh `Result`, possibly with a
// different error type. `f` is a plain top-level function reference (Mort
// has no closures). See `is_ok`'s resource-drop note for `value`'s consuming
// semantics.
pub fn or_else<Value, Error, MappedError>(value: Result<Value, Error>, f: fn(Error) -> Result<Value, MappedError>) -> Result<Value, MappedError> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Result<Value, MappedError>.Ok(move payload); }
        Result<Value, Error>.Err(payload) => { return f(move payload); }
    }
}

// Consumes both `value` and `other`; returns `value` unchanged (re-wrapped
// as `Result<Value, MappedError>.Ok`, with `other` dropped unused —
// automatically, for a resource `MappedError` — never touching it) if
// `value` is `Ok`; otherwise returns `other` directly (the original error
// payload is discarded — automatically, for a resource `Error`). The eager
// counterpart to `or_else`, matching `std.option.or`'s relationship to
// `or_else`: `or_else` calls `f(error)` to produce the fallback `Result`
// only when needed; `or` takes the fallback directly, for the common case
// where it doesn't depend on the error payload at all.
pub fn or<Value, Error, MappedError>(value: Result<Value, Error>, other: Result<Value, MappedError>) -> Result<Value, MappedError> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Result<Value, MappedError>.Ok(move payload); }
        Result<Value, Error>.Err(payload) => { return move other; }
    }
}

// Consumes `value`; converts to `std.option.Option`, the natural counterpart
// to `std.option.ok_or`. An `Ok` payload becomes `Some`; an `Err` payload is
// discarded (dropped automatically for a resource `Error`) and the result is
// `None`.
pub fn ok<Value, Error>(value: Result<Value, Error>) -> Option<Value> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Option<Value>.Some(move payload); }
        Result<Value, Error>.Err(payload) => { return Option<Value>.None; }
    }
}

// Consumes `value`; the error-side counterpart to `ok`. An `Err` payload
// becomes `Some`; an `Ok` payload is discarded (dropped automatically for a
// resource `Value`) and the result is `None`.
pub fn err<Value, Error>(value: Result<Value, Error>) -> Option<Error> {
    match move value {
        Result<Value, Error>.Ok(payload) => { return Option<Error>.None; }
        Result<Value, Error>.Err(payload) => { return Option<Error>.Some(move payload); }
    }
}

// Moves `new_value` into `*value`, returning whatever was there before.
// Unlike every helper above, this reads/writes through a pointer rather
// than consuming `value` by name, so it works on a `Result` stored in a
// struct field or a `Vec` slot that can't otherwise be moved out of
// directly. Resource-safe the same way `std.option.replace` is: `*value`
// is read into a local before being overwritten through the raw pointer
// (exempt from the "cannot overwrite a resource binding" check, the same
// exemption `std.option.take`/`replace` and `Vec`/`Map`'s mutating helpers
// rely on), so the old payload is never duplicated and never destroyed
// twice.
//
// There is no `take` here: `Option::take` leaves a cheap `None` behind for
// free, but `Result` has no equivalent "empty" variant — both `Ok` and
// `Err` always carry a real payload, and Mort has no `Default` trait to
// conjure a placeholder one from. A caller wanting `take`-like behavior
// supplies the placeholder explicitly via `replace`.
pub fn replace<Value, Error>(value: *Result<Value, Error>, new_value: Result<Value, Error>) -> Result<Value, Error> {
    let current = *value;
    *value = move new_value;
    return move current;
}
