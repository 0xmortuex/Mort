module std.map;

import std.option;
import std.vec;

resource struct Map<Key, Value> {
    keys: *Key,
    values: *Value,
    length: u64,
    capacity: u64,
}

pub fn with_capacity<Key, Value>(capacity: u64) -> Map<Key, Value> {
    let actual = capacity;
    if actual == 0 {
        actual = 1;
    }
    let keys = alloc(actual * sizeof<Key>()) as *Key;
    let values = alloc(actual * sizeof<Value>()) as *Value;
    return Map<Key, Value> {
        keys: keys,
        values: values,
        length: 0,
        capacity: actual,
    };
}

pub fn new<Key, Value>() -> Map<Key, Value> {
    return with_capacity<Key, Value>(4);
}

fn find<Key, Value>(value: *Map<Key, Value>, key: Key) -> Option<u64> {
    for index: u64 in 0..(*value).length {
        if (*value).keys[index] == key {
            return Option<u64>.Some(index);
        }
    }
    return Option<u64>.None;
}

pub fn reserve<Key, Value>(value: *Map<Key, Value>, capacity: u64) -> void {
    if capacity <= (*value).capacity {
        return;
    }
    let keys = alloc(capacity * sizeof<Key>()) as *Key;
    let values = alloc(capacity * sizeof<Value>()) as *Value;
    for index: u64 in 0..(*value).length {
        keys[index] = (*value).keys[index];
        values[index] = (*value).values[index];
    }
    free((*value).keys);
    free((*value).values);
    (*value).keys = keys;
    (*value).values = values;
    (*value).capacity = capacity;
}

pub fn insert<Key, Value>(
value: *Map<Key, Value>,
key: Key,
item: Value
) -> bool {
    let existing = find(value, key);
    match existing {
        Option<u64>.Some(index) => {
            // Overwrites the previous value in place; a resource Value must be
            // drained by the caller first, since slot storage is raw memory.
            (*value).values[index] = move item;
            return false;
        },
        Option<u64>.None => {},
    }
    if (*value).length == (*value).capacity {
        reserve(value, (*value).capacity * 2);
    }
    // Move key and value into their (uninitialized) backing slots.
    (*value).keys[(*value).length] = move key;
    (*value).values[(*value).length] = move item;
    (*value).length = (*value).length + 1;
    return true;
}

pub fn get<Key, Value>(value: *Map<Key, Value>, key: Key) -> Option<Value> {
    let existing = find(value, key);
    match existing {
        Option<u64>.Some(index) => {
            return Option<Value>.Some((*value).values[index]);
        },
        Option<u64>.None => {
            return Option<Value>.None;
        },
    }
}

// Returns a pointer to the live value slot for `key` instead of `get`'s
// aliasing copy (a null pointer, `0 as *Value`, if `key` is absent), so a
// resource Value can be read/written/moved in place without duplicating or
// dropping ownership. Mirrors Vec.get_ref: the pointer is only valid until
// the next operation that can reallocate backing storage (insert past
// capacity).
pub fn get_ref<Key, Value>(value: *Map<Key, Value>, key: Key) -> *Value {
    let existing = find(value, key);
    match existing {
        Option<u64>.Some(index) => {
            return &(*value).values[index];
        },
        Option<u64>.None => {
            return 0 as *Value;
        },
    }
}

pub fn key_at<Key, Value>(value: *Map<Key, Value>, index: u64) -> Option<Key> {
    if index >= (*value).length {
        return Option<Key>.None;
    }
    return Option<Key>.Some((*value).keys[index]);
}

pub fn value_at<Key, Value>(value: *Map<Key, Value>, index: u64) -> Option<Value> {
    if index >= (*value).length {
        return Option<Value>.None;
    }
    return Option<Value>.Some((*value).values[index]);
}

// Collects every key, in insertion order, into a freshly allocated Vec.
// Same aliasing-copy caveat as key_at/Map.get (not resource-safe for a
// resource Key, since each entry is copied, not moved, out of the map).
pub fn keys<Key, Value>(value: *Map<Key, Value>) -> Vec<Key> {
    let result: Vec<Key> = vec.with_capacity<Key>((*value).length);
    for index: u64 in 0..(*value).length {
        vec.push(&result, (*value).keys[index]);
    }
    return move result;
}

// Collects every value, in insertion order, into a freshly allocated Vec.
// Same aliasing-copy caveat as value_at/Map.get (not resource-safe for a
// resource Value, since each entry is copied, not moved, out of the map).
pub fn values<Key, Value>(value: *Map<Key, Value>) -> Vec<Value> {
    let result: Vec<Value> = vec.with_capacity<Value>((*value).length);
    for index: u64 in 0..(*value).length {
        vec.push(&result, (*value).values[index]);
    }
    return move result;
}

// Returns the key of the first entry (in insertion order) for which
// `predicate(key, value)` is true, or None if no entry matches. Like
// key_at/value_at, this reads key and value via an aliasing copy — see the
// resource caveats note for Map.get.
pub fn find_by<Key, Value>(
value: *Map<Key, Value>,
predicate: fn(Key, Value) -> bool
) -> Option<Key> {
    for index: u64 in 0..(*value).length {
        if predicate((*value).keys[index], (*value).values[index]) {
            return Option<Key>.Some((*value).keys[index]);
        }
    }
    return Option<Key>.None;
}

pub fn contains<Key, Value>(value: *Map<Key, Value>, key: Key) -> bool {
    let existing = find(value, key);
    match existing {
        Option<u64>.Some(index) => { return true; },
        Option<u64>.None => { return false; },
    }
}

pub fn remove<Key, Value>(value: *Map<Key, Value>, key: Key) -> Option<Value> {
    let existing = find(value, key);
    match existing {
        Option<u64>.Some(index) => {
            // Move the slot's value out before the shift below overwrites it.
            let removed = Option<Value>.Some((*value).values[index]);
            let last = (*value).length - 1;
            for cursor: u64 in index..last {
                (*value).keys[cursor] = (*value).keys[cursor + 1];
                (*value).values[cursor] = (*value).values[cursor + 1];
            }
            (*value).length = last;
            return move removed;
        },
        Option<u64>.None => {
            return Option<Value>.None;
        },
    }
}

pub fn is_empty<Key, Value>(value: *Map<Key, Value>) -> bool {
    return (*value).length == 0;
}

pub fn clear<Key, Value>(value: *Map<Key, Value>) -> void {
    (*value).length = 0;
}

// Returns a new Map holding a copy of every key/value pair, in insertion
// order, built from with_capacity plus a direct array copy (the Map
// equivalent of Vec.clone's with_capacity + extend). Like Vec.clone, this is
// **not** safe for a resource Key or Value: entries are copied, not moved,
// so a resource would end up aliased between the original and the copy.
pub fn clone<Key, Value>(value: *Map<Key, Value>) -> Map<Key, Value> {
    let result = with_capacity<Key, Value>((*value).length);
    for index: u64 in 0..(*value).length {
        result.keys[index] = (*value).keys[index];
        result.values[index] = (*value).values[index];
    }
    result.length = (*value).length;
    return move result;
}

// Inserts every entry of `other` into `value`, in `other`'s insertion order
// (a key already present in `value` is overwritten, the same as a direct
// `insert` call — see insert's overwrite-of-an-existing-key caveat), the Map
// counterpart to Vec.extend. Like `clone`, this is **not** safe for a
// resource Key or Value: each entry is read out of `other` by copy, not
// moved, so a resource would end up aliased between the two maps.
pub fn merge<Key, Value>(value: *Map<Key, Value>, other: *Map<Key, Value>) -> void {
    for index: u64 in 0..(*other).length {
        insert(value, (*other).keys[index], (*other).values[index]);
    }
}

pub fn destroy<Key, Value>(value: *Map<Key, Value>) -> void {
    free((*value).keys);
    free((*value).values);
    (*value).keys = 0 as *Key;
    (*value).values = 0 as *Value;
    (*value).length = 0;
    (*value).capacity = 0;
}
