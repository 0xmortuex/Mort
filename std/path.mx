// Mort standard library: pure string manipulation over POSIX-style
// (forward-slash) paths. No filesystem syscalls here — see std.fs for
// actual I/O. Every function treats `path` as plain []const u8 text; none
// of them touch the filesystem to resolve what is actually there.

module std.path;

import std.owned_string;
import std.strings;

// The view of `path` after its last '/', or the whole of `path` if it has
// none. Mirrors Python's `os.path.basename`/Rust's `Path::file_name`
// (modulo the Option wrapping Rust uses for edge cases this does not
// special-case): a trailing '/' means the basename is empty, matching
// Python (`os.path.basename("a/b/")  == ""`). The returned view borrows
// from `path`, no allocation.
pub fn basename(path: []const u8) -> []const u8 {
    match strings.rsplit_once(path, slice("/" as *const u8, 1)) {
        Option<SplitOnce>.Some(parts) => { return parts.after; },
        Option<SplitOnce>.None => { return path; },
    }
}

// The view of `path` before its last '/', or "." if it has none, matching
// Python's `os.path.dirname` convention of returning "." for a bare
// filename with no directory component. A leading-only '/' (e.g. "/a")
// yields an empty `before`, which this returns as-is (an empty root
// directory view), matching `os.path.dirname("/a") == "/"` only in spirit
// — callers that need the exact POSIX root behavior should special-case a
// single leading '/' themselves. The returned view borrows from `path`, no
// allocation.
pub fn dirname(path: []const u8) -> []const u8 {
    match strings.rsplit_once(path, slice("/" as *const u8, 1)) {
        Option<SplitOnce>.Some(parts) => { return parts.before; },
        Option<SplitOnce>.None => { return slice("." as *const u8, 1); },
    }
}

// The view of `basename(path)` after its last '.', or `None` if the
// basename has no '.' or the '.' is its first byte (so a dotfile like
// ".bashrc" has no extension), matching Python's `os.path.splitext`. The
// returned view borrows from `path`, no allocation.
pub fn extension(path: []const u8) -> Option<[]const u8> {
    let name: []const u8 = basename(path);
    match strings.rsplit_once(name, slice("." as *const u8, 1)) {
        Option<SplitOnce>.Some(parts) => {
            if parts.before.len == 0 {
                return Option<[]const u8>.None;
            }
            return Option<[]const u8>.Some(parts.after);
        },
        Option<SplitOnce>.None => { return Option<[]const u8>.None; },
    }
}

// Joins `left` and `right` with exactly one '/' between them, unless one
// side already supplies it (a trailing '/' on `left` or a leading '/' on
// `right`), in which case no extra separator is inserted. An empty `left`
// or `right` is treated like any other text — no special-casing — so
// `join("", "b")` is `"/b"` and `join("a", "")` is `"a/"`. The result is a
// freshly allocated owned buffer; the caller must call
// `std.owned_string.destroy` on it.
pub fn join(left: []const u8, right: []const u8) -> String {
    let left_has_slash: bool = left.len > 0 && left[left.len - 1] == 47;
    let right_has_slash: bool = right.len > 0 && right[0] == 47;
    let result: String = owned_string.from_slice(left);
    if !left_has_slash && !right_has_slash {
        owned_string.append(&result, slice("/" as *const u8, 1));
    }
    owned_string.append(&result, right);
    return move result;
}
