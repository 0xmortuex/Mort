module std.algorithm;

import std.option;

pub fn reverse<T>(values: []T) -> void {
    if values.len < 2 {
        return;
    }
    let left: u64 = 0;
    let right = values.len - 1;
    while left < right {
        let temporary = values[left];
        values[left] = values[right];
        values[right] = temporary;
        left += 1;
        right -= 1;
    }
}

// Reverses the half-open range [start, end) of `values` in place, via a
// moved-out temporary per swapped pair (see `reverse`). Shared by
// `rotate_left`/`rotate_right` below.
fn reverse_range<T>(values: []T, start: u64, end: u64) -> void {
    let count = end - start;
    for index: u64 in 0..(count / 2) {
        let temporary = values[start + index];
        values[start + index] = values[end - 1 - index];
        values[end - 1 - index] = move temporary;
    }
}

// Rotates `values` in place so the element at `count` becomes the new
// first element; the first `count` elements move to the end, preserving
// their relative order (matching Rust's `slice::rotate_left`), the
// bare-slice counterpart to `std.vec.rotate_left`. `count` is taken modulo
// `values.len` (so `count >= values.len` wraps rather than being a no-op
// or out-of-bounds), and an empty slice is always a no-op. Built on the
// standard three-reversal trick — reverse [0, count), reverse [count,
// length), then reverse the whole slice. Like `slice_reverse`, this is
// *not* usable for a resource element type: the typechecker's
// resource-overwrite check only exempts assignment through a raw pointer,
// not through a slice, so `values[index] = ...` on a resource `T` is
// rejected at compile time.
pub fn rotate_left<T>(values: []T, count: u64) -> void {
    let length = values.len;
    if length == 0 {
        return;
    }
    let amount = count % length;
    if amount == 0 {
        return;
    }
    reverse_range(values, 0, amount);
    reverse_range(values, amount, length);
    reverse_range(values, 0, length);
}

// Rotates `values` in place so the last `count` elements move to the
// front, preserving their relative order (matching Rust's
// `slice::rotate_right`), the bare-slice counterpart to
// `std.vec.rotate_right`. Equivalent to `rotate_left(values, length -
// count % length)`; see `rotate_left` for the wraparound, empty-slice, and
// resource-element caveats.
pub fn rotate_right<T>(values: []T, count: u64) -> void {
    let length = values.len;
    if length == 0 {
        return;
    }
    let amount = count % length;
    if amount == 0 {
        return;
    }
    rotate_left(values, length - amount);
}

pub fn sort<T>(values: []T) -> void {
    for index: u64 in 1..values.len {
        let position = index;
        while position > 0 && values[position] < values[position - 1] {
            let temporary = values[position];
            values[position] = values[position - 1];
            values[position - 1] = temporary;
            position -= 1;
        }
    }
}

pub fn index_of<T>(values: []const T, needle: T) -> Option<u64> {
    for index: u64 in 0..values.len {
        if values[index] == needle {
            return Option<u64>.Some(index);
        }
    }
    return Option<u64>.None;
}

pub fn contains<T>(values: []const T, needle: T) -> bool {
    for index: u64 in 0..values.len {
        if values[index] == needle {
            return true;
        }
    }
    return false;
}

// Returns the index of the first element for which `predicate(element)` is
// true, or None if no element matches. Unlike `index_of`/`contains`, this
// does not require `T` to support `==` — the only way to search a slice of
// a struct type (which can't be compared with `==` at all) for a matching
// element without hand-rolling the scan loop, mirroring `std.map.find_by`.
pub fn find_by<T>(values: []const T, predicate: fn(T) -> bool) -> Option<u64> {
    for index: u64 in 0..values.len {
        if predicate(values[index]) {
            return Option<u64>.Some(index);
        }
    }
    return Option<u64>.None;
}

// True if `predicate` holds for at least one element, false for an empty
// slice (vacuous-truth convention, matching e.g. Rust's `Iterator::any`).
pub fn any<T>(values: []const T, predicate: fn(T) -> bool) -> bool {
    for index: u64 in 0..values.len {
        if predicate(values[index]) {
            return true;
        }
    }
    return false;
}

// True if `predicate` holds for every element, true for an empty slice
// (vacuous-truth convention, matching e.g. Rust's `Iterator::all`).
pub fn all<T>(values: []const T, predicate: fn(T) -> bool) -> bool {
    for index: u64 in 0..values.len {
        if !predicate(values[index]) {
            return false;
        }
    }
    return true;
}

// Number of elements for which `predicate` holds, 0 for an empty slice.
// The counting counterpart to `any`/`all`: those stop at the first
// true/false result, this scans the whole slice and tallies.
pub fn count<T>(values: []const T, predicate: fn(T) -> bool) -> u64 {
    let total: u64 = 0;
    for index: u64 in 0..values.len {
        if predicate(values[index]) {
            total += 1;
        }
    }
    return total;
}

pub fn min<T>(values: []const T) -> Option<T> {
    if values.len == 0 {
        return Option<T>.None;
    }
    let best = values[0];
    for index: u64 in 1..values.len {
        if values[index] < best {
            best = values[index];
        }
    }
    return Option<T>.Some(best);
}

pub fn max<T>(values: []const T) -> Option<T> {
    if values.len == 0 {
        return Option<T>.None;
    }
    let best = values[0];
    for index: u64 in 1..values.len {
        if values[index] > best {
            best = values[index];
        }
    }
    return Option<T>.Some(best);
}

// The comparator-taking counterparts to `min`/`max`: those require `T` to
// support `<`/`>`, so they can't find the smallest/largest element by a
// caller-supplied order (e.g. the shortest string in a `[]const []const
// u8` by `.len`, or a struct by one of its fields). Built the same
// single-pass-keeping-the-best-so-far loop as `min`/`max`, mirroring how
// `std.sort.sort` takes an explicit `less_than` where `std.algorithm.sort`
// requires `<`. `None` for an empty slice.
pub fn min_by<T>(values: []const T, less_than: fn(T, T) -> bool) -> Option<T> {
    if values.len == 0 {
        return Option<T>.None;
    }
    let best = values[0];
    for index: u64 in 1..values.len {
        if less_than(values[index], best) {
            best = values[index];
        }
    }
    return Option<T>.Some(best);
}

pub fn max_by<T>(values: []const T, less_than: fn(T, T) -> bool) -> Option<T> {
    if values.len == 0 {
        return Option<T>.None;
    }
    let best = values[0];
    for index: u64 in 1..values.len {
        if less_than(best, values[index]) {
            best = values[index];
        }
    }
    return Option<T>.Some(best);
}

// Collapses *consecutive* equal elements of `values` in place, the
// slice-level counterpart to `std.vec.dedup`. Keeps the first element of
// each run and returns the new logical length; unlike a `Vec`, a slice has
// no `.length` field to shrink, so the caller re-slices with the returned
// length if it wants the shrunk view. Compares via `==`, the same
// convention as `index_of`/`contains` (works for primitive T; struct-typed
// T generally can't be compared this way). Not safe for a resource-typed
// T: a dropped duplicate is overwritten, not destroyed, the same caveat
// `std.vec.dedup` already documents.
pub fn dedup<T>(values: []T) -> u64 {
    if values.len <= 1 {
        return values.len;
    }
    let write: u64 = 0;
    for read: u64 in 1..values.len {
        if values[write] != values[read] {
            write = write + 1;
            values[write] = values[read];
        }
    }
    return write + 1;
}
