module std.option;

import std.result;

enum Option<T> {
    Some(T),
    None,
}

// Consumes `value`; for a resource `T` a `Some` payload is dropped by this
// call (there is no by-reference variant, since Mort enums expose no
// tag-only inspection without a match).
pub fn is_some<T>(value: Option<T>) -> bool {
    match move value {
        Option<T>.Some(payload) => { return true; }
        Option<T>.None => { return false; }
    }
}

// Consumes `value`; see `is_some`'s resource-drop note.
pub fn is_none<T>(value: Option<T>) -> bool {
    match move value {
        Option<T>.Some(payload) => { return false; }
        Option<T>.None => { return true; }
    }
}

// Consumes both `value` and `default`; returns the `Some` payload, or
// `default` if `value` is `None`. For a resource `T`, whichever of the two
// is not returned is dropped automatically.
pub fn unwrap_or<T>(value: Option<T>, default: T) -> T {
    match move value {
        Option<T>.Some(payload) => { return move payload; }
        Option<T>.None => { return move default; }
    }
}

// Consumes `value`; returns the `Some` payload, or the result of calling
// `f()` if `value` is `None`. The lazy counterpart to `unwrap_or`: `f` is
// only called when `value` is `None`, so use this instead of `unwrap_or`
// when computing the default is expensive or has side effects. `f` is a
// plain top-level function reference taking no arguments (Mort has no
// closures). See `is_some`'s resource-drop note for `value`'s consuming
// semantics.
pub fn unwrap_or_else<T>(value: Option<T>, f: fn() -> T) -> T {
    match move value {
        Option<T>.Some(payload) => { return move payload; }
        Option<T>.None => { return f(); }
    }
}

// Consumes `value`; applies `f` to a `Some` payload and wraps the result as
// `Option<U>.Some(...)`, or returns `Option<U>.None` unchanged if `value`
// is `None`. `f` is a plain top-level function reference (Mort has no
// closures), matching the `predicate`-argument convention already used by
// `std.map.find_by`. See `is_some`'s resource-drop note for `value`'s
// consuming semantics.
pub fn map<T, U>(value: Option<T>, f: fn(T) -> U) -> Option<U> {
    match move value {
        Option<T>.Some(payload) => { return Option<U>.Some(f(move payload)); }
        Option<T>.None => { return Option<U>.None; }
    }
}

// Consumes both `value` and `error`; converts to `std.result.Result`, the
// natural counterpart to `std.result.ok`. A `Some` payload becomes `Ok`,
// with `error` dropped unused (automatically, for a resource `Error`);
// `None` becomes `Err(error)`.
pub fn ok_or<T, Error>(value: Option<T>, error: Error) -> Result<T, Error> {
    match move value {
        Option<T>.Some(payload) => { return Result<T, Error>.Ok(move payload); }
        Option<T>.None => { return Result<T, Error>.Err(move error); }
    }
}
