module std.option;

import std.result;

enum Option<T> {
    Some(T),
    None,
}

// Consumes `value`; for a resource `T` a `Some` payload is dropped by this
// call (there is no by-reference variant, since Mort enums expose no
// tag-only inspection without a match).
pub fn is_some<T>(value: Option<T>) -> bool {
    match move value {
        Option<T>.Some(payload) => { return true; }
        Option<T>.None => { return false; }
    }
}

// Consumes `value`; see `is_some`'s resource-drop note.
pub fn is_none<T>(value: Option<T>) -> bool {
    match move value {
        Option<T>.Some(payload) => { return false; }
        Option<T>.None => { return true; }
    }
}

// Consumes both `value` and `default`; returns the `Some` payload, or
// `default` if `value` is `None`. For a resource `T`, whichever of the two
// is not returned is dropped automatically.
pub fn unwrap_or<T>(value: Option<T>, default: T) -> T {
    match move value {
        Option<T>.Some(payload) => { return move payload; }
        Option<T>.None => { return move default; }
    }
}

// Consumes `value`; returns the `Some` payload, or the result of calling
// `f()` if `value` is `None`. The lazy counterpart to `unwrap_or`: `f` is
// only called when `value` is `None`, so use this instead of `unwrap_or`
// when computing the default is expensive or has side effects. `f` is a
// plain top-level function reference taking no arguments (Mort has no
// closures). See `is_some`'s resource-drop note for `value`'s consuming
// semantics.
pub fn unwrap_or_else<T>(value: Option<T>, f: fn() -> T) -> T {
    match move value {
        Option<T>.Some(payload) => { return move payload; }
        Option<T>.None => { return f(); }
    }
}

// Consumes `value`; applies `f` to a `Some` payload and wraps the result as
// `Option<U>.Some(...)`, or returns `Option<U>.None` unchanged if `value`
// is `None`. `f` is a plain top-level function reference (Mort has no
// closures), matching the `predicate`-argument convention already used by
// `std.map.find_by`. See `is_some`'s resource-drop note for `value`'s
// consuming semantics.
pub fn map<T, U>(value: Option<T>, f: fn(T) -> U) -> Option<U> {
    match move value {
        Option<T>.Some(payload) => { return Option<U>.Some(f(move payload)); }
        Option<T>.None => { return Option<U>.None; }
    }
}

// Consumes `value`; applies `f` to a `Some` payload and returns its result
// directly (no extra `Some`-wrapping, unlike `map`), or returns
// `Option<U>.None` unchanged (never calling `f`) if `value` is `None`. The
// "flat-map" counterpart to `map`, for chaining functions that already
// return an `Option` themselves (e.g. a parse step that can itself fail).
// `f` is a plain top-level function reference (Mort has no closures). See
// `is_some`'s resource-drop note for `value`'s consuming semantics.
pub fn and_then<T, U>(value: Option<T>, f: fn(T) -> Option<U>) -> Option<U> {
    match move value {
        Option<T>.Some(payload) => { return f(move payload); }
        Option<T>.None => { return Option<U>.None; }
    }
}

// Consumes both `value` and `other`; returns `other` unchanged if `value`
// is `Some` (the `Some` payload itself is discarded — automatically dropped
// for a resource `T` — only `value`'s tag matters), or returns
// `Option<U>.None` if `value` is `None`, dropping `other` unused
// (automatically, for a resource `U`). The eager counterpart to
// `and_then`: `and_then` calls `f(payload)` to produce the next `Option`,
// using `value`'s payload; `and` instead takes the next `Option` directly,
// for the common case where the next step doesn't depend on `value`'s
// contents at all (so there is no `f` to write, just a plain no-argument
// fallback expression to pass in).
pub fn and<T, U>(value: Option<T>, other: Option<U>) -> Option<U> {
    match move value {
        Option<T>.Some(payload) => { return move other; }
        Option<T>.None => { return Option<U>.None; }
    }
}

// Consumes `value`; applies `predicate` to a reference to the `Some`
// payload (via `&payload`, not by moving it in, unlike `map`/`and_then`'s
// `f`) and, if `predicate` is true, returns `value` unchanged as
// `Option<T>.Some(...)`; if `predicate` is false, the payload is dropped
// (automatically, for a resource `T`) and `Option<T>.None` is returned.
// `None` passes through unchanged without calling `predicate`. Taking the
// payload by reference, rather than by value like `map`/`and_then`'s `f`,
// is what lets the same payload be inspected and then still moved back out
// into the returned `Some` — a by-value predicate would consume it on the
// call and leave nothing to rewrap.
pub fn filter<T>(value: Option<T>, predicate: fn(*T) -> bool) -> Option<T> {
    match move value {
        Option<T>.Some(payload) => {
            if predicate(&payload) {
                return Option<T>.Some(move payload);
            }
            return Option<T>.None;
        }
        Option<T>.None => { return Option<T>.None; }
    }
}

// Consumes `value`; returns `value` unchanged (re-wrapped as `Option<T>.Some`)
// if it is `Some`, never calling `f`; otherwise calls `f()` and returns its
// result directly. The `None`-side counterpart to `and_then`, matching
// `std.result.or_else`'s shape (minus an error payload, since `f` here takes
// no arguments, like `unwrap_or_else`'s). `f` is a plain top-level function
// reference (Mort has no closures). See `is_some`'s resource-drop note for
// `value`'s consuming semantics.
pub fn or_else<T>(value: Option<T>, f: fn() -> Option<T>) -> Option<T> {
    match move value {
        Option<T>.Some(payload) => { return Option<T>.Some(move payload); }
        Option<T>.None => { return f(); }
    }
}

// Consumes both `value` and `error`; converts to `std.result.Result`, the
// natural counterpart to `std.result.ok`. A `Some` payload becomes `Ok`,
// with `error` dropped unused (automatically, for a resource `Error`);
// `None` becomes `Err(error)`.
pub fn ok_or<T, Error>(value: Option<T>, error: Error) -> Result<T, Error> {
    match move value {
        Option<T>.Some(payload) => { return Result<T, Error>.Ok(move payload); }
        Option<T>.None => { return Result<T, Error>.Err(move error); }
    }
}
