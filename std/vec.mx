module std.vec;

import std.option;

resource struct Vec<T> {
    data: *T,
    length: u64,
    capacity: u64,
}

pub fn with_capacity<T>(capacity: u64) -> Vec<T> {
    let actual = capacity;
    if actual == 0 {
        actual = 1;
    }
    let data = alloc(actual * sizeof<T>()) as *T;
    return Vec<T> { data: data, length: 0, capacity: actual };
}

pub fn new<T>() -> Vec<T> {
    return with_capacity<T>(4);
}

pub fn reserve<T>(value: *Vec<T>, capacity: u64) -> void {
    if capacity <= (*value).capacity {
        return;
    }
    let replacement = alloc(capacity * sizeof<T>()) as *T;
    for index: u64 in 0..(*value).length {
        replacement[index] = (*value).data[index];
    }
    free((*value).data);
    (*value).data = replacement;
    (*value).capacity = capacity;
}

pub fn push<T>(value: *Vec<T>, item: T) -> void {
    if (*value).length == (*value).capacity {
        reserve(value, (*value).capacity * 2);
    }
    // Move the element into the (uninitialized) backing slot. For a resource T
    // this transfers ownership so `item` is not dropped when push returns; for
    // a plain T it is an ordinary copy.
    (*value).data[(*value).length] = move item;
    (*value).length = (*value).length + 1;
}

pub fn get<T>(value: *Vec<T>, index: u64) -> Option<T> {
    if index >= (*value).length {
        return Option<T>.None;
    }
    return Option<T>.Some((*value).data[index]);
}

pub fn set<T>(value: *Vec<T>, index: u64, item: T) -> bool {
    if index >= (*value).length {
        return false;
    }
    // For a resource T the previous occupant is overwritten in place; the
    // caller is responsible for having drained it, since raw slot storage is
    // outside the ownership checker's view.
    (*value).data[index] = move item;
    return true;
}

pub fn pop<T>(value: *Vec<T>) -> Option<T> {
    if (*value).length == 0 {
        return Option<T>.None;
    }
    (*value).length = (*value).length - 1;
    return Option<T>.Some((*value).data[(*value).length]);
}

pub fn remove<T>(value: *Vec<T>, index: u64) -> Option<T> {
    if index >= (*value).length {
        return Option<T>.None;
    }
    // Move the slot's value out before the shift below overwrites it.
    let removed = Option<T>.Some((*value).data[index]);
    let last = (*value).length - 1;
    for cursor: u64 in index..last {
        (*value).data[cursor] = (*value).data[cursor + 1];
    }
    (*value).length = last;
    return move removed;
}

pub fn insert<T>(value: *Vec<T>, index: u64, item: T) -> bool {
    if index > (*value).length {
        return false;
    }
    if (*value).length == (*value).capacity {
        reserve(value, (*value).capacity * 2);
    }
    // Shift the tail up one slot, from the end down to `index`, to open a gap.
    let cursor = (*value).length;
    while cursor > index {
        (*value).data[cursor] = (*value).data[cursor - 1];
        cursor = cursor - 1;
    }
    (*value).data[index] = move item;
    (*value).length = (*value).length + 1;
    return true;
}

pub fn is_empty<T>(value: *Vec<T>) -> bool {
    return (*value).length == 0;
}

// Returns the index of the first element equal to `item` (in order), or
// None if no element matches. Reads elements via an aliasing copy to
// compare — see the resource caveats note for Vec.get.
pub fn index_of<T>(value: *Vec<T>, item: T) -> Option<u64> {
    for index: u64 in 0..(*value).length {
        if (*value).data[index] == item {
            return Option<u64>.Some(index);
        }
    }
    return Option<u64>.None;
}

// Returns the first element, or None if the Vec is empty. A thin wrapper
// over get(value, 0) — see the resource caveats note for Vec.get.
pub fn first<T>(value: *Vec<T>) -> Option<T> {
    return get(value, 0);
}

// Returns the last element, or None if the Vec is empty. A thin wrapper
// over get(value, length - 1) — see the resource caveats note for Vec.get.
pub fn last<T>(value: *Vec<T>) -> Option<T> {
    if (*value).length == 0 {
        return Option<T>.None;
    }
    return get(value, (*value).length - 1);
}

// Exchanges the elements at `i` and `j` in place. Returns false and leaves
// the Vec unchanged if either index is out of bounds; swapping an index
// with itself is a no-op that still returns true. Unlike Vec.get/set, this
// does not alias or drop a resource T: each slot's value is moved out and
// back in exactly once, so it is safe for resource element types (verified
// under --sanitize address --sanitize leak with a resource struct).
pub fn swap<T>(value: *Vec<T>, i: u64, j: u64) -> bool {
    if i >= (*value).length || j >= (*value).length {
        return false;
    }
    if i == j {
        return true;
    }
    let temporary = (*value).data[i];
    (*value).data[i] = (*value).data[j];
    (*value).data[j] = move temporary;
    return true;
}

// Reverses the Vec's elements in place, resource-safe (built on `swap`,
// which moves rather than aliases each slot). A Vec of length 0 or 1 is
// left unchanged.
pub fn reverse<T>(value: *Vec<T>) -> void {
    let length = (*value).length;
    for index: u64 in 0..(length / 2) {
        swap(value, index, length - 1 - index);
    }
}

// Reverses a bare `[]T` slice in place, `reverse`'s counterpart for
// content that isn't wrapped in a `Vec` (e.g. `as_slice`'s borrowed view,
// or a caller's own array-backed slice). Each pair of slots is exchanged
// through a moved-out temporary, the same approach `reverse`/`swap` use for
// `Vec`. Unlike `reverse`/`swap`, this is *not* usable for a resource
// element type: the typechecker's resource-overwrite check only exempts
// assignment through a raw pointer (`*T`, as `Vec`'s backing storage is),
// not through a slice, so `value[index] = ...` on a resource `T` is
// rejected at compile time with "cannot overwrite a resource binding"
// rather than compiling into something unsafe. A slice of length 0 or 1 is
// left unchanged.
pub fn slice_reverse<T>(value: []T) -> void {
    let length = value.len;
    for index: u64 in 0..(length / 2) {
        let temporary = value[index];
        value[index] = value[length - 1 - index];
        value[length - 1 - index] = move temporary;
    }
}

// Reverses the half-open range [start, end) in place, via `swap` (see
// `reverse`). Shared by `rotate_left`/`rotate_right` below.
fn reverse_range<T>(value: *Vec<T>, start: u64, end: u64) -> void {
    let count = end - start;
    for index: u64 in 0..(count / 2) {
        swap(value, start + index, end - 1 - index);
    }
}

// Rotates the Vec in place so the element at `count` becomes the new first
// element; the first `count` elements move to the end, preserving their
// relative order (matching Rust's `slice::rotate_left`). `count` is taken
// modulo `length` (so `count >= length` wraps rather than being a no-op or
// out-of-bounds), and an empty Vec is always a no-op. Built on the standard
// three-reversal trick — reverse [0, count), reverse [count, length), then
// reverse the whole Vec — so it inherits `swap`'s resource-safety.
pub fn rotate_left<T>(value: *Vec<T>, count: u64) -> void {
    let length = (*value).length;
    if length == 0 {
        return;
    }
    let amount = count % length;
    if amount == 0 {
        return;
    }
    reverse_range(value, 0, amount);
    reverse_range(value, amount, length);
    reverse_range(value, 0, length);
}

// Rotates the Vec in place so the last `count` elements move to the front,
// preserving their relative order (matching Rust's `slice::rotate_right`).
// Equivalent to `rotate_left(value, length - count % length)`; see
// `rotate_left` for the wraparound and empty-Vec behavior.
pub fn rotate_right<T>(value: *Vec<T>, count: u64) -> void {
    let length = (*value).length;
    if length == 0 {
        return;
    }
    let amount = count % length;
    if amount == 0 {
        return;
    }
    rotate_left(value, length - amount);
}

pub fn contains<T>(value: *Vec<T>, item: T) -> bool {
    let existing = index_of(value, item);
    match existing {
        Option<u64>.Some(index) => { return true; },
        Option<u64>.None => { return false; },
    }
}

pub fn as_slice<T>(value: *Vec<T>) -> []T {
    return slice((*value).data, (*value).length);
}

pub fn as_const_slice<T>(value: *Vec<T>) -> []const T {
    return slice((*value).data as *const T, (*value).length);
}

pub fn clear<T>(value: *Vec<T>) -> void {
    (*value).length = 0;
}

pub fn destroy<T>(value: *Vec<T>) -> void {
    free((*value).data);
    (*value).data = 0 as *T;
    (*value).length = 0;
    (*value).capacity = 0;
}
