import std.https;
import std.tls;

fn inspect(stream: *Stream) -> i64 {
    let bytes: [u8; 4] = [0; 4];
    let sent = tls.send(
        stream,
        &bytes[0] as *const u8,
        4
    );
    let received = tls.receive(stream, &bytes[0], 4);
    return sent + received + tls.protocol_version(stream) as i64;
}

fn main() -> int {
    let roots = "test roots";
    let response: [u8; 512] = [0; 512];
    let response_length = https.get_with_ca(
        "localhost",
        443,
        "/",
        &response[0],
        512,
        roots as *const u8,
        len(roots)
    );
    print(response_length);
    let stream = tls.connect_with_ca(
        "localhost",
        443,
        roots as *const u8,
        len(roots)
    );
    print(inspect(&stream));
    return 0;
}
